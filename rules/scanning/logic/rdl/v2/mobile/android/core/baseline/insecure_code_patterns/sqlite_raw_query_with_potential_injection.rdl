VERSION 2
RULE baseline.mobile.android.core.sqlite_raw_query_with_potential_injection VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\.rawQuery\\s*\\(|\\.execSQL\\s*\\(" "im"
WHEN TEXT_MISSING "selectionArgs\\s*=|bindString\\s*\\(|bindLong\\s*\\(|\\?,\\s*new\\s+String" "im"
REPORT "SQLite Raw Query with Potential Injection"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
