VERSION 2
RULE baseline.java.core.ldap_injection_initialdircontext_search_with_user_input VERSION 1
IN FILE
WHEN TEXT_MATCHES "InitialDirContext|InitialLdapContext|DirContext\\.search\\s*\\(" "im"
WHEN (TEXT_MATCHES "request|getParameter|getHeader|query|input" "im" AND TEXT_MISSING "escapeLDAPSearchFilter|ESAPI\\.encoder\\(\\)\\.encodeForLDAP|ldapEscape" "im")
REPORT "LDAP Injection: InitialDirContext Search with User Input"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
