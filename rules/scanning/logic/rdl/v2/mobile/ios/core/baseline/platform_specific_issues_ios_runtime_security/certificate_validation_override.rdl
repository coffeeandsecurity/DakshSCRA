VERSION 2
RULE baseline.mobile.ios.core.certificate_validation_override VERSION 1
IN FILE
WHEN TEXT_MATCHES "didReceive\\s+challenge|NSURLSessionAuthChallengeDisposition\\.useCredential" "im"
WHEN (TEXT_MISSING "SecTrustEvaluate|SecPolicyCreateSSL|pinnedCertificates|ServerTrustManager" "im" AND TEXT_MISSING "test|development|localhost" "im")
REPORT "Certificate Validation Override"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
