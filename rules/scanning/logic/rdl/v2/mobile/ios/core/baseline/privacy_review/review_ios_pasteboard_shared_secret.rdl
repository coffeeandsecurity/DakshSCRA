VERSION 2
RULE baseline.mobile.ios.core.review_ios_pasteboard_shared_secret VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)\\bUIPasteboard\\s*\\.\\s*general\\s*\\.\\s*string\\s*=\\s*(?:[\\w]+\\.)?(?:password|token|secret|credential)\\w*" "im"
REPORT "Clipboard Data Exposure Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
