VERSION 2
RULE baseline.bash.core.hardcoded_credential_in_shell_script VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)(password|passwd|secret|api_key|apikey|token|access_key)\\s*=\\s*['\"]?[A-Za-z0-9@#$%^&*!_\\-]{8,}['\"]?" "im"
WHEN TEXT_MISSING "vault|secret_manager|\\$\\{.*\\}" "im"
REPORT "Hardcoded Credential in Shell Script"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
