VERSION 2
RULE baseline.golang.framework.echo.echo_sql_query_concatenation_sink VERSION 1
IN FILE
WHEN TEXT_MATCHES "Query\\(\\s*fmt\\.Sprintf|Exec\\(\\s*fmt\\.Sprintf|Raw\\(\\s*fmt\\.Sprintf" "im"
WHEN TEXT_MISSING "prepare|parameterize|\\?.*args|sqlx\\.NamedExec|squirrel" "im"
REPORT "Echo SQL Query Concatenation Sink"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
