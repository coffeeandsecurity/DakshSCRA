VERSION 2
RULE baseline.mobile.ios.core.insecure_random_number_generation VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\barc4random\\s*\\(|\\barc4random_uniform\\s*\\(|\\brand\\s*\\(|\\bsrand\\s*\\(|\\bdrand48\\s*\\(" "im"
REPORT "Security-Sensitive Randomness Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
