VERSION 2
RULE baseline.mobile.android.core.autofill_not_disabled_on_sensitive_input_fields VERSION 1
IN FILE
WHEN TEXT_MATCHES "[A-Za-z_][\\w.-]*:inputType\\s*=\\s*[\"'][^\"']*(?:textPassword|textVisiblePassword|numberPassword)" "im"
REPORT "Sensitive Input Autofill Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
