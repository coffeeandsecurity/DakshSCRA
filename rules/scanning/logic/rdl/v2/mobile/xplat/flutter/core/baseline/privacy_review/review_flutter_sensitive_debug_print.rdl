VERSION 2
RULE baseline.mobile.xplat.flutter.core.review_flutter_sensitive_debug_print VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)\\b(?:debugPrint|print)\\s*\\([^\\n;]{0,200}\\b(?:password|token|secret|credential)\\b" "im"
REPORT "Sensitive Data Logging Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
