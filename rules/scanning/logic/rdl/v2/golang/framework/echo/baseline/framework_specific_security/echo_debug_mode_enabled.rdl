VERSION 2
RULE baseline.golang.framework.echo.echo_debug_mode_enabled VERSION 1
IN FILE
WHEN TEXT_MATCHES "GIN_MODE\\s*=\\s*debug|SetMode\\(\\s*gin\\.DebugMode\\s*\\)|\\.Debug\\s*=\\s*true" "im"
WHEN (TEXT_MISSING "production|release|ReleaseMode|GIN_MODE.*release" "im" AND TEXT_MISSING "test|development" "im")
REPORT "Echo Debug Mode Enabled"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
