VERSION 2
RULE baseline.java.core.executable_file_storage_on_external_storage VERSION 1
IN FILE
WHEN TEXT_MATCHES "(Environment\\.getExternalStorageDirectory|Context\\.getExternalFilesDir)\\s*\\(\\)\\s*.*\\.(dex|so|jar|apk)" "im"
WHEN TEXT_MISSING "getInternalFilesDir|getFilesDir|getNoBackupFilesDir|test|example" "im"
REPORT "External Executable Storage Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
