VERSION 2
RULE baseline.python.framework.flask.flask_debug_mode_enabled VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\bDEBUG\\s*=\\s*True\\b|FLASK_DEBUG\\s*=\\s*1|reload\\s*=\\s*True" "im"
WHEN TEXT_MISSING "release|production" "im"
REPORT "Flask Debug Mode Enabled"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
