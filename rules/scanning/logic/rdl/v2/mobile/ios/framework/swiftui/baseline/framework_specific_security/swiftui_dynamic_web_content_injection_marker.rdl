VERSION 2
RULE baseline.mobile.ios.framework.swiftui.swiftui_dynamic_web_content_injection_marker VERSION 1
IN FILE
WHEN TEXT_MATCHES "WKWebView|evaluateJavaScript\\(|JavaScriptEnabled" "im"
WHEN TEXT_MISSING "limitsNavigationsToAppBoundDomains\\s*=\\s*true" "im"
REPORT "SwiftUI Dynamic Web Content Injection Marker"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
