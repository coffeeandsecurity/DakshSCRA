VERSION 2
RULE baseline.bash.core.missing_errexit_or_pipefail_options VERSION 1
IN FILE
WHEN TEXT_MATCHES "^#!\\s*/(?:bin/|usr/bin/env\\s+)(?:bash|sh)\\b" "im"
WHEN TEXT_MISSING "set\\s+-[euo]*e|set\\s+-o\\s+errexit" "im"
REPORT "Missing errexit or pipefail Options"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
