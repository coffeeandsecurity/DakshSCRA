VERSION 2
RULE baseline.dotnet.core.untrusted_url_concatenation_append_method VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\.Append\\(.*HttpContext\\.Current\\.Request\\.Url" "im"
WHEN TEXT_MISSING "(Uri\\.EscapeDataString|UrlEncode|IsLocalUrl|allowlist|whitelist)" "im"
REPORT "Untrusted URL Concatenation: Append Method"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
