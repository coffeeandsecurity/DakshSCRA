VERSION 2
RULE baseline.cpp.core.null_pointer_dereference_with_smart_pointers VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\b(std::unique_ptr|std::shared_ptr)<.*>\\s*=\\s*nullptr" "im"
WHEN TEXT_MISSING "if\\s*\\(.*!=\\s*nullptr\\)|if\\s*\\(.*!=\\s*NULL\\)|assert\\s*\\(|nullptr\\s*!=" "im"
REPORT "Smart Pointer Nullability Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
