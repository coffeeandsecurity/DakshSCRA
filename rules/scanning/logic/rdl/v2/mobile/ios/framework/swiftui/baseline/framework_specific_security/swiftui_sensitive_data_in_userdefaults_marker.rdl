VERSION 2
RULE baseline.mobile.ios.framework.swiftui.swiftui_sensitive_data_in_userdefaults_marker VERSION 1
IN FILE
WHEN TEXT_MATCHES "UserDefaults\\.standard\\.set\\(.*(token|secret|password|apikey)" "im"
WHEN TEXT_MISSING "Keychain" "im"
REPORT "SwiftUI Sensitive Data in UserDefaults Marker"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
