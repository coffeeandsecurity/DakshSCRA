VERSION 2
RULE baseline.mobile.android.core.review_android_webview_file_url_access VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\b(?:setAllowFileAccessFromFileURLs\\s*\\(\\s*true\\s*\\)|allowFileAccessFromFileURLs\\s*=\\s*true\\b)" "im"
REPORT "WebView File Access Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
