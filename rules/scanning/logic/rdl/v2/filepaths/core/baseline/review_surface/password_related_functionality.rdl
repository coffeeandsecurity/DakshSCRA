VERSION 2
RULE baseline.filepaths.core.password_related_functionality VERSION 1
IN PATH
WHEN TEXT_MATCHES "(?i)(Password|password|pwd|passwd|credential|forgotpassword)" "im"
WHEN (TEXT_MATCHES "(?i)(/|\\\\\\\\).*(password|credential|auth|secret)" "im" AND TEXT_MISSING "(?i)(/docs?/|/examples?/|/samples?/|/tests?/|example|sample|dummy|test|placeholder)" "im")
REPORT "Password Handling Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
