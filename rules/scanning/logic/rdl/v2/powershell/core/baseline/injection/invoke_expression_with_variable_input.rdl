VERSION 2
RULE baseline.powershell.core.invoke_expression_with_variable_input VERSION 1
IN FILE
WHEN TEXT_MATCHES "Invoke-Expression\\s+[\"']?.*\\$\\w|iex\\s+[\"']?.*\\$\\w" "im"
WHEN TEXT_MISSING "Validate|Sanitize|allowlist|\\[ValidateSet\\]|\\[ValidatePattern\\]" "im"
REPORT "Dynamic Code Evaluation Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
