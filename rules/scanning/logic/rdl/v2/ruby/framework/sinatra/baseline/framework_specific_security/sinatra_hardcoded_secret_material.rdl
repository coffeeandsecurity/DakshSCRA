VERSION 2
RULE baseline.ruby.framework.sinatra.sinatra_hardcoded_secret_material VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)(secret_key_base|secret|apikey|token|password)\\s*[:=]\\s*[\\'\\\"][^\\'\\\"]{8,}[\\'\\\"]" "im"
REPORT "Sinatra Hardcoded Secret Material"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
