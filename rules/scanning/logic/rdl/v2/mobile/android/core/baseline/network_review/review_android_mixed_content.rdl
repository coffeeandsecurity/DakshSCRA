VERSION 2
RULE baseline.mobile.android.core.review_android_mixed_content VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\b(?:setMixedContentMode\\s*\\(\\s*(?:WebSettings\\.)?|mixedContentMode\\s*=\\s*(?:WebSettings\\.)?)MIXED_CONTENT_ALWAYS_ALLOW\\b" "im"
REPORT "WebView Mixed Content Allowed"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
