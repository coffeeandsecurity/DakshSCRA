VERSION 2
RULE baseline.filepaths.core.payment_functionality VERSION 1
IN PATH
WHEN TEXT_MATCHES "(?i)(payment|pay)" "im"
WHEN (TEXT_MATCHES "(?i)(/|\\\\\\\\).*(payment|billing|checkout|invoice|transaction)" "im" AND TEXT_MISSING "(?i)(/docs?/|/examples?/|/samples?/|/tests?/)" "im")
REPORT "Payment Functionality"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
