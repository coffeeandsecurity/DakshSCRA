VERSION 2
RULE baseline.filepaths.core.security_functionality VERSION 1
IN PATH
WHEN TEXT_MATCHES "(?i)security" "im"
WHEN (TEXT_MATCHES "(?i)(/|\\\\\\\\).*(security|auth|policy|hardening)" "im" AND TEXT_MISSING "(?i)(/docs?/|/examples?/|/samples?/|/tests?/)" "im")
REPORT "Security Functionality"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
