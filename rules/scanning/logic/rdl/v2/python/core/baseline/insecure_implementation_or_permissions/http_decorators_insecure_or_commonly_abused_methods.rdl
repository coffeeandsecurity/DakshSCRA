VERSION 2
RULE baseline.python.core.http_decorators_insecure_or_commonly_abused_methods VERSION 1
IN FILE
WHEN TEXT_MATCHES "(@require_http_methods\\s*\\(\\s*\\[\"(?:GET|PUT|DELETE|.*?)\"\\]\\))|(@require_GET)" "im"
WHEN TEXT_MISSING "@login_required|@permission_required|validate|sanitize" "im"
REPORT "HTTP Method Handling Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
