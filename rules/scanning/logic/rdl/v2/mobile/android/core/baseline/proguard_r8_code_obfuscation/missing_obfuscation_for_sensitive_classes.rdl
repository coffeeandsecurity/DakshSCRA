VERSION 2
RULE baseline.mobile.android.core.missing_obfuscation_for_sensitive_classes VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)-keepclassmembers\\s+class\\s+[^\\n{]*(?:password|secret|token|apikey)[^\\n{]*" "im"
WHEN TEXT_MISSING "example|sample|dummy|test|placeholder" "im"
REPORT "Missing Obfuscation for Sensitive Classes"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
