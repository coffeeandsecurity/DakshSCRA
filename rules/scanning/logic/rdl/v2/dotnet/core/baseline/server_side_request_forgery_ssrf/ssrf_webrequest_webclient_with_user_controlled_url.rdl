VERSION 2
RULE baseline.dotnet.core.ssrf_webrequest_webclient_with_user_controlled_url VERSION 1
IN FILE
WHEN TEXT_MATCHES "WebRequest\\.Create\\s*\\(|new\\s+WebClient\\s*\\(\\s*\\)|new\\s+HttpWebRequest\\s*\\(" "im"
WHEN (TEXT_MATCHES "Request\\.|QueryString|Form|userInput|\\+" "im" AND TEXT_MISSING "allowlist|whitelist|Uri\\.IsWellFormedUriString" "im")
REPORT "Server-Side Request Forgery Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
