VERSION 2
RULE baseline.javascript.core.sql_query_non_parameterized_insert_statements VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)\\bINSERT\\s+INTO\\s+[^\\s]+\\s+\\(.*=.*\\$.*\\)" "im"
WHEN TEXT_MISSING "\\?|prepare|bind|replacements|sequelize\\.query\\s*\\(.*replacements|mysql\\.escape|pg\\.escape" "im"
REPORT "SQL Parameterization Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
