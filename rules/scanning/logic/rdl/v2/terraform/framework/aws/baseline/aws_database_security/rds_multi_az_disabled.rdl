VERSION 2
RULE baseline.terraform.framework.aws.rds_multi_az_disabled VERSION 1
IN FILE
WHEN TEXT_MATCHES "resource\\s+\"aws_db_instance\"[^}]*multi_az\\s*=\\s*false" "im"
WHEN (TEXT_MATCHES "multi_az\\s*=\\s*false" "im" AND TEXT_MISSING "# intentional|# development|# staging|# cost" "im")
REPORT "RDS Multi-AZ Disabled"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
