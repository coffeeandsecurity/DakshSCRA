VERSION 2
RULE baseline.php.core.arbitrary_code_execution_eval_and_exec VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\b(?:eval|exec)\\b" "im"
WHEN (TEXT_MATCHES "\\$_(GET|POST|REQUEST|COOKIE)|base64_decode|gzinflate|str_rot13|preg_replace" "im" AND TEXT_MISSING "allowlist|whitelist" "im")
REPORT "Arbitrary Code Execution: eval and exec"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
