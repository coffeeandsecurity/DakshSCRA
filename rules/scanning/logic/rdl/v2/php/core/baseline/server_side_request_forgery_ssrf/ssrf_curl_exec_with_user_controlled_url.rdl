VERSION 2
RULE baseline.php.core.ssrf_curl_exec_with_user_controlled_url VERSION 1
IN FILE
WHEN TEXT_MATCHES "curl_setopt\\s*\\(\\s*\\$\\w+\\s*,\\s*CURLOPT_URL|curl_init\\s*\\(\\s*\\$_(GET|POST|REQUEST|COOKIE)" "im"
WHEN TEXT_MISSING "allowlist|whitelist|filter_var\\s*\\(.*FILTER_VALIDATE_URL|parse_url|CURLOPT_PROTOCOLS" "im"
REPORT "SSRF: curl_exec with User-Controlled URL"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
