VERSION 2
RULE baseline.mobile.xplat.xamarin.core.webview_javascript_enabled VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\b(?:WebView|HybridWebView).*?(?:JavaScriptEnabled\\s*=\\s*true|EnableJavascript\\s*=\\s*true)" "im"
WHEN (TEXT_MISSING "ShouldOverrideUrlLoading|NavigationDelegate|allowList|trustedOrigins" "im" AND TEXT_MISSING "test|example" "im")
REPORT "WebView JavaScript Enabled"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
