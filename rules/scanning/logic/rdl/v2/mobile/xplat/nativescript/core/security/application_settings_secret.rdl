VERSION 2
RULE nativescript.application-settings-secret VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)\\b(?:applicationSettings|ApplicationSettings)\\.setString\\s*\\(\\s*[\"\\x27](?:password|token|secret|credential)[\"\\x27]" ""
REPORT "Preferences Data Storage Review"
SEVERITY MEDIUM
CONFIDENCE LOW
WITH TRACE
