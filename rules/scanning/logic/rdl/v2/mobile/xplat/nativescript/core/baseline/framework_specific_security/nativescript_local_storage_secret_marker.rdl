VERSION 2
RULE baseline.mobile.xplat.nativescript.core.nativescript_local_storage_secret_marker VERSION 1
IN FILE
WHEN TEXT_MATCHES "(application-settings|secure-storage|localStorage)\\.(setString|setItem)\\(.*(token|secret|password|apikey)" "im"
REPORT "NativeScript Local Storage Secret Marker"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
