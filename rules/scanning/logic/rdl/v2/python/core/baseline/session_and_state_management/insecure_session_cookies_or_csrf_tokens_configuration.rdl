VERSION 2
RULE baseline.python.core.insecure_session_cookies_or_csrf_tokens_configuration VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)\\b(SESSION_COOKIE_SECURE|CSRF_COOKIE_SECURE)\\s*=\\s*False\\b" "im"
WHEN TEXT_MISSING "SESSION_COOKIE_SECURE\\s*=\\s*True|CSRF_COOKIE_SECURE\\s*=\\s*True|production|test|example" "im"
REPORT "Session Cookie Protection Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
