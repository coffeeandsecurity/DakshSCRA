VERSION 2
RULE baseline.python.core.sql_query_direct_delete_with_user_input VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)\\bDELETE\\s+FROM\\s+[^\\s]+\\s+WHERE\\s+.*=.*\\$.*" "im"
WHEN TEXT_MISSING "%s|\\?|:\\w+|params=|execute\\(" "im"
REPORT "SQL Query: Direct DELETE with User Input"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
