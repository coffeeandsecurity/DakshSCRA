VERSION 2
RULE baseline.bash.core.credentials_passed_via_command_line_arguments VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)(?:--password|--secret|--token|--key|--api-key)\\s*=?\\s*\\S" "im"
WHEN TEXT_MISSING "\\$\\{|\\$\\(" "im"
REPORT "Credentials Passed via Command Line Arguments"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
