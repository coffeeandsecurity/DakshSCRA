VERSION 2
RULE baseline.dotnet.framework.identity.account_lockout_disabled VERSION 1
IN FILE
WHEN TEXT_MATCHES "LockoutOnFailure\\s*=\\s*false|LockoutEnabled\\s*=\\s*false" "im"
WHEN (TEXT_MATCHES "AllowedForNewUsers\\s*=\\s*false|MaxFailedAccessAttempts\\s*=\\s*0|LockoutEnabled\\s*=\\s*false" "im" AND TEXT_MISSING "test|example" "im")
REPORT "Account Lockout Disabled"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
