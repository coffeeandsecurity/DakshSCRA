VERSION 2
RULE baseline.mobile.ios.core.review_ios_minimum_tls_version VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\b(?:tlsMinimumSupportedProtocolVersion\\s*=\\s*\\.TLSv1[01]|tlsMinimumSupportedProtocol\\s*=\\s*\\.(?:tlsProtocol1|tlsProtocol11))\\b" "im"
REPORT "TLS Protocol Version Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
