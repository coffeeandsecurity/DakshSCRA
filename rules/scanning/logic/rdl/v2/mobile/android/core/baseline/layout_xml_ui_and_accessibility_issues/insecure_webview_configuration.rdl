VERSION 2
RULE baseline.mobile.android.core.insecure_webview_configuration VERSION 1
IN FILE
WHEN TEXT_MATCHES "WebView.*setJavaScriptEnabled\\(true\\)" "im"
WHEN (TEXT_MATCHES "setJavaScriptEnabled\\s*\\(\\s*true" "im" AND TEXT_MISSING "setAllowFileAccess\\s*\\(\\s*false|setSafeBrowsingEnabled\\s*\\(\\s*true|setWebViewClient|shouldOverrideUrlLoading" "im")
REPORT "Insecure WebView Configuration"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
