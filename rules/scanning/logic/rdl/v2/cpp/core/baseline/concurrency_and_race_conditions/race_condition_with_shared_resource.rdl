VERSION 2
RULE baseline.cpp.core.race_condition_with_shared_resource VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\bpthread_create\\s*\\(.*\\);\\s*.*\\s*=.*shared_var" "im"
WHEN TEXT_MISSING "mutex|lock|atomic|pthread_mutex|synchronized|volatile\\s+std::atomic|std::mutex|__sync_|std::lock_guard" "im"
REPORT "Race Condition with Shared Resource"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
