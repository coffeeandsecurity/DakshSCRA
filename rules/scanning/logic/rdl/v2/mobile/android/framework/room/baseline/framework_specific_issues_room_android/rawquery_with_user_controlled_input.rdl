VERSION 2
RULE baseline.mobile.android.framework.room.rawquery_with_user_controlled_input VERSION 1
IN FILE
WHEN TEXT_MATCHES "@RawQuery|rawQuery\\s*\\(\\s*[^,)]*\\+" "im"
WHEN TEXT_MISSING "SupportSQLiteQuery|SimpleSQLiteQuery|bindArgs" "im"
REPORT "RawQuery with User-Controlled Input"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
