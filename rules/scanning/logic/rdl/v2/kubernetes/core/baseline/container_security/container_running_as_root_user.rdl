VERSION 2
RULE baseline.kubernetes.core.container_running_as_root_user VERSION 1
IN FILE
WHEN TEXT_MATCHES "runAsUser\\s*:\\s*0\\b|runAsNonRoot\\s*:\\s*false" "im"
WHEN (TEXT_MATCHES "runAsUser:\\s*0|runAsNonRoot:\\s*false" "im" AND TEXT_MISSING "# intentional|# required" "im")
REPORT "Container User Configuration Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
