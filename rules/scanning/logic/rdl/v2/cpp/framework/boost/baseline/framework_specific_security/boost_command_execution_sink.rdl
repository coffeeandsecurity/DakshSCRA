VERSION 2
RULE baseline.cpp.framework.boost.boost_command_execution_sink VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\b(system|popen|_popen)\\s*\\(" "im"
WHEN (TEXT_MISSING "validate|sanitize|allowlist|whitelist" "im" AND TEXT_MISSING "test|example" "im")
REPORT "Boost Command Execution Sink"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
