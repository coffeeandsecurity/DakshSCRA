VERSION 2
RULE baseline.mobile.xplat.xamarin.core.webview_javascript_enabled VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\b(?:WebView|HybridWebView)(?:[^\\n]*|[^;{}]*?)(?:JavaScriptEnabled\\s*=\\s*true|EnableJavascript\\s*=\\s*true)" "im"
REPORT "WebView JavaScript Policy Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
