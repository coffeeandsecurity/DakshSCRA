VERSION 2
RULE ios.insecure-unarchive-surface VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\b(?:unarchiveObjectWithData|unarchiveObjectWithFile|unarchiveTopLevelObjectWithData)\\s*[:(]|\\brequiresSecureCoding\\s*=\\s*(?:false|NO)\\b|\\bunarchiveObject\\s*\\(\\s*(?:with|withFile)\\s*:" ""
REPORT "Unrestricted Objective-C Object Unarchive"
SEVERITY MEDIUM
CONFIDENCE LOW
WITH TRACE
