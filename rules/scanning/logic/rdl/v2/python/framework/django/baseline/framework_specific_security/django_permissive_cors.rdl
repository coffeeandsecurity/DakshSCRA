VERSION 2
RULE baseline.python.framework.django.django_permissive_cors VERSION 1
IN FILE
WHEN TEXT_MATCHES "allow_origins\\s*=\\s*\\[\\s*[\\'\\\"]\\*[\\'\\\"]\\s*\\]|CORS\\(.*origins\\s*=\\s*[\\'\\\"]\\*[\\'\\\"]" "im"
WHEN TEXT_MISSING "allowlist|trusted_origins|configuration\\.allowed_origins" "im"
REPORT "Django Permissive CORS"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
