VERSION 2
RULE baseline.php.framework.wordpress.wordpress_dangerous_dynamic_eval_template_execution VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\beval\\s*\\(|assert\\s*\\(\\s*\\$|create_function\\s*\\(" "im"
WHEN TEXT_MISSING "validate|allowlist|trusted|esc_attr|wp_kses|test|example" "im"
REPORT "Wordpress Dangerous Dynamic Eval/Template Execution"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
