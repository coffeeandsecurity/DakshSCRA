VERSION 2
RULE baseline.terraform.framework.gcp.gcp_vm_with_os_login_disabled VERSION 1
IN FILE
WHEN TEXT_MATCHES "enable-oslogin\\s*=\\s*\"FALSE\"|enable-oslogin\\s*=\\s*\"false\"" "im"
WHEN (TEXT_MATCHES "enable-oslogin\\s*=\\s*\"false\"|enable-oslogin\\s*=\\s*false" "im" AND TEXT_MISSING "# intentional|# legacy|# migration" "im")
REPORT "GCP VM with OS Login Disabled"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
