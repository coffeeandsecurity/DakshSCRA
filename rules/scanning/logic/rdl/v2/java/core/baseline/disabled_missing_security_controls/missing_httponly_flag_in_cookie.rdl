VERSION 2
RULE baseline.java.core.missing_httponly_flag_in_cookie VERSION 1
IN FILE
WHEN TEXT_MATCHES "(\\bSet-Cookie:\\s*)(?!(?:(?=(?P<rdl_cookie_segment>[^\\n]*?;\\s*))(?P=rdl_cookie_segment))*HttpOnly\\b).*" "im"
WHEN TEXT_MISSING "setHttpOnly\\s*\\(\\s*true|setSecure\\s*\\(\\s*true|SameSite" "im"
REPORT "Session Cookie Protection Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
