VERSION 2
RULE baseline.mobile.xplat.kmp.core.kmp_certificate_validation_bypass VERSION 1
IN FILE
WHEN TEXT_MATCHES "hostnameVerifier\\s*\\{(?:[^\\n]*|[^;{}]*?)true|trustAll|InsecureTrustManager|X509TrustManager" "im"
REPORT "TLS Certificate Validation Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
