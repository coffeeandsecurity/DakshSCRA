VERSION 2
RULE baseline.php.core.insecure_variable_injection_extract VERSION 1
IN FILE
WHEN TEXT_MATCHES "extract\\s*\\(\\s*(\\$_(GET|POST|REQUEST)|\\$\\{?(?:_[a-zA-Z0-9_]+|[a-zA-Z_\\x7f-\\xff][a-zA-Z0-9_\\x7f-\\xff]*)\\}?)\\s*,\\s*(?:\\s*EXTR_(?:OVERWRITE|SKIP|PREFIX_SAME|PREFIX_ALL|IF_EXISTS|IF_DOESNT_EXIST|PREFIX_INVALID))?" "im"
WHEN (TEXT_MISSING "EXTR_SKIP|EXTR_PREFIX_ALL|allowlist|filter_var|validate" "im" AND TEXT_MISSING "test|example" "im")
REPORT "Variable Injection Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
