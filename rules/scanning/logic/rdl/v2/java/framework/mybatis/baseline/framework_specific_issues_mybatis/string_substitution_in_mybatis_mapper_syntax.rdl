VERSION 2
RULE baseline.java.framework.mybatis.string_substitution_in_mybatis_mapper_syntax VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\$\\{(?!__frch_|index|item|foreach)[^}]+\\}" "im"
WHEN (TEXT_MISSING "#\\{|@Param|parameterType" "im" AND TEXT_MISSING "validate|sanitize" "im")
REPORT "SQL Template Substitution Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
