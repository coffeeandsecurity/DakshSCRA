VERSION 2
RULE baseline.common.core.admin_modules_section VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)\\b(admin_login|admin_portal|admin_module|admin_interface|administrator)\\b" "im"
WHEN (TEXT_MATCHES "(?i)\\b(auth|role|permission|access)\\b" "im" AND TEXT_MISSING "(?i)\\b(readme|changelog|example|sample|docs?)\\b" "im")
REPORT "Admin Modules/Section"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
