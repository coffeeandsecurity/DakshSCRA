VERSION 2
RULE baseline.mobile.ios.framework.coredata.review_ios_coredata_unprotected_persistent_store VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\bsetOption\\s*\\(\\s*FileProtectionType\\.none\\b[^\\n]{0,160}\\bNSPersistentStoreFileProtectionKey\\b" "im"
REPORT "Core Data Protection Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
