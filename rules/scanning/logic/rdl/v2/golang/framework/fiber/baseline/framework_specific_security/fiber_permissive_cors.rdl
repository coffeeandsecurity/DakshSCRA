VERSION 2
RULE baseline.golang.framework.fiber.fiber_permissive_cors VERSION 1
IN FILE
WHEN TEXT_MATCHES "AllowOrigins\\s*:\\s*\\[\\]\\s*string\\{\\s*\"\\*\"\\s*\\}|AllowOrigins\\s*:\\s*\"\\*\"" "im"
WHEN (TEXT_MATCHES "AllowOrigins.*\"\\*\"|AllowOrigins.*\\*" "im" AND TEXT_MISSING "AllowOrigins.*\"https?://[^*]|AllowOriginFunc|AllowCredentials.*false" "im")
REPORT "Fiber Permissive CORS"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
