VERSION 2
RULE baseline.mobile.android.framework.jetpack.review_android_jetpack_saved_state_secret VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)\\bsavedStateHandle\\s*\\[\\s*\"(?:password|token|secret|credential)\"\\s*\\]\\s*=" "im"
REPORT "Saved State Data Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
