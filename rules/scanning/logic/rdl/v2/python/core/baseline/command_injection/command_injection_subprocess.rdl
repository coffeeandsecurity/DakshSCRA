VERSION 2
RULE baseline.python.core.command_injection_subprocess VERSION 1
IN FILE
WHEN TEXT_MATCHES "subprocess\\.run\\(.*\\)" "im"
WHEN (TEXT_MATCHES "(shell=True|input\\(|request|params|query|argv)" "im" AND TEXT_MISSING "(shlex\\.quote|list2cmdline|allowlist|whitelist)" "im")
REPORT "Command Injection: subprocess"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
