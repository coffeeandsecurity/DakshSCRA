VERSION 2
RULE baseline.mobile.xplat.nativescript.core.weak_local_secret_storage VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\b(?:application-settings|ApplicationSettings\\.set|setString\\s*\\()" "im"
WHEN TEXT_MATCHES "ApplicationSettings\\.setString.*(?:password|token|secret|key|credential)|getString.*(?:password|token|secret|key|credential)" "im"
REPORT "Weak Local Secret Storage"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
