VERSION 2
RULE baseline.mobile.xplat.xamarin.core.insecure_local_storage_of_secrets VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\b(?:Preferences\\.Set|Application\\.Current\\.Properties\\[)" "im"
WHEN TEXT_MATCHES "Preferences\\.Set.*(?:password|token|secret|key|auth|credential)|Application\\.Current\\.Properties\\[.*(?:password|token|secret|key|auth|credential)" "im"
REPORT "Insecure Local Storage of Secrets"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
