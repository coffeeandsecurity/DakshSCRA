VERSION 2
RULE baseline.terraform.framework.azure.azure_vm_with_password_authentication_enabled VERSION 1
IN FILE
WHEN TEXT_MATCHES "disable_password_authentication\\s*=\\s*false" "im"
WHEN (TEXT_MATCHES "disable_password_authentication\\s*=\\s*false" "im" AND TEXT_MISSING "# intentional|# development|admin_ssh_key" "im")
REPORT "Azure VM Authentication Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
