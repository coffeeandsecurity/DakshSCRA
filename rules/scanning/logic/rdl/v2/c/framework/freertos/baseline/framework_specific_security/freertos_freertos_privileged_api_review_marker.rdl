VERSION 2
RULE baseline.c.framework.freertos.freertos_freertos_privileged_api_review_marker VERSION 1
IN FILE
WHEN TEXT_MATCHES "vTaskPrioritySet\\(|xTaskCreate\\(|xQueueReceive\\(" "im"
WHEN TEXT_MISSING "assert|check|verify|privilege_check|permission" "im"
REPORT "FreeRTOS Privileged API Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
