VERSION 2
RULE baseline.filepaths.core.input_validation VERSION 1
IN PATH
WHEN TEXT_MATCHES "(?i)(validation|sanitize|input)" "im"
WHEN (TEXT_MATCHES "(?i)(/|\\\\\\\\).*(validation|validator|sanitize|input)" "im" AND TEXT_MISSING "(?i)(/docs?/|/examples?/|/samples?/|/tests?/)" "im")
REPORT "Input Validation Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
