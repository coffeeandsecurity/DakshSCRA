VERSION 2
RULE baseline.ruby.core.weak_session_secret_configuration VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)secret_key_base\\s*[:=]\\s*[\"'](?:changeme|secret|test|default)[\"']" "im"
WHEN (TEXT_MATCHES "secret_key_base\\s*[:=]\\s*[\"'](changeme|secret|test|default|password|123)[\"']|SECRET_KEY_BASE.*=.*[\"']\\w{4,20}[\"']" "im" AND TEXT_MISSING "Rails\\.application\\.credentials|ENV\\[|ENV\\.fetch" "im")
REPORT "Weak Session Secret Configuration"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
