VERSION 2
RULE baseline.dockerfile.core.secret_passed_via_env_instruction VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)^ENV\\s+(?:PASSWORD|SECRET|API_KEY|APIKEY|TOKEN|ACCESS_KEY|PRIVATE_KEY|AUTH_TOKEN)\\s*=?\\s*\\S" "im"
WHEN (TEXT_MISSING "placeholder|example|test|dummy|TODO" "im" AND TEXT_MISSING "ARG\\s+\\w+\\s*$|--build-arg|SECRET_" "im")
REPORT "Secret Passed via ENV Instruction"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
