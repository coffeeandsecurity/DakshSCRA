VERSION 2
RULE baseline.php.core.xxe_xmlreader_or_xmlparser_without_external_entity_protection VERSION 1
IN FILE
WHEN TEXT_MATCHES "xml_parser_create\\s*\\(|XMLReader::open\\s*\\(|new\\s+XMLReader\\s*\\(" "im"
WHEN TEXT_MISSING "libxml_disable_entity_loader|XML_OPTION_SKIP_WHITE|LIBXML_NOENT\\s*=\\s*0" "im"
REPORT "XXE: XMLReader or XMLParser Without External Entity Protection"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
