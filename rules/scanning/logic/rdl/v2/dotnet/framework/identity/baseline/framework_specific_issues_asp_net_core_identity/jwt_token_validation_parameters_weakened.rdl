VERSION 2
RULE baseline.dotnet.framework.identity.jwt_token_validation_parameters_weakened VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\b(?:ValidateIssuer|ValidateAudience|ValidateLifetime|ValidateIssuerSigningKey|RequireSignedTokens)\\s*=\\s*false\\b" "im"
REPORT "JWT Validation Policy Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
