VERSION 2
RULE baseline.php.framework.codeigniter.codeigniter_hardcoded_secret_material VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)(APP_KEY|SECRET|API[_-]?KEY|TOKEN|PASSWORD)\\s*[:=]\\s*['\\\"][^'\\\"$]{8,}['\\\"]" "im"
REPORT "Hardcoded Credential or Secret Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
