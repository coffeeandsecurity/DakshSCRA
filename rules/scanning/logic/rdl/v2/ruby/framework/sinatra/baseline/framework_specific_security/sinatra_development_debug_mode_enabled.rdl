VERSION 2
RULE baseline.ruby.framework.sinatra.sinatra_development_debug_mode_enabled VERSION 1
IN FILE
WHEN TEXT_MATCHES "RAILS_ENV\\s*=\\s*[\\'\\\"]development[\\'\\\"]|config\\.consider_all_requests_local\\s*=\\s*true" "im"
WHEN TEXT_MISSING "release|production" "im"
REPORT "Debug Mode Configuration Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
