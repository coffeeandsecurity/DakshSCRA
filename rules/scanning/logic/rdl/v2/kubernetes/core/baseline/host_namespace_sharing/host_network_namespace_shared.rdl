VERSION 2
RULE baseline.kubernetes.core.host_network_namespace_shared VERSION 1
IN FILE
WHEN TEXT_MATCHES "hostNetwork\\s*:\\s*true" "im"
WHEN (TEXT_MATCHES "hostNetwork:\\s*true" "im" AND TEXT_MISSING "# intentional|# required" "im")
REPORT "Host Network Namespace Shared"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
