VERSION 2
RULE baseline.mobile.xplat.nativescript.core.review_nativescript_application_settings_secret VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)\\b(?:applicationSettings|ApplicationSettings)\\.setString\\s*\\(\\s*[\"\\x27](?:password|token|secret|credential)[\"\\x27]" "im"
REPORT "Preferences Data Storage Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
