VERSION 2
RULE baseline.mobile.xplat.xamarin.core.review_xamarin_preferences_secret VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)\\bPreferences(?:\\.Default)?\\.Set\\s*\\(\\s*\"(?:password|token|secret|credential)\"" "im"
REPORT "Xamarin Preferences Stores Sensitive Value"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
