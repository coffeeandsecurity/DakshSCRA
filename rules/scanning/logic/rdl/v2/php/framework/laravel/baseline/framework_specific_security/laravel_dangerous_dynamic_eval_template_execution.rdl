VERSION 2
RULE baseline.php.framework.laravel.laravel_dangerous_dynamic_eval_template_execution VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\beval\\s*\\(|assert\\s*\\(\\s*\\$|create_function\\s*\\(" "im"
WHEN TEXT_MISSING "validate|allowlist|trusted|Blade::|test|example" "im"
REPORT "Dynamic Code Evaluation Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
