VERSION 2
RULE baseline.dotnet.core.untrusted_input_request_form VERSION 1
IN FILE
WHEN TEXT_MATCHES "Request\\.Form" "im"
WHEN (TEXT_MATCHES "(SqlCommand|Execute|Response\\.Write|Redirect|File|Path|Process|Xml)" "im" AND TEXT_MISSING "(ValidateInput|HtmlEncode|UrlEncode|Sanitize|TryParse|Regex\\.IsMatch)" "im")
REPORT "Untrusted Input Entry Point"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
