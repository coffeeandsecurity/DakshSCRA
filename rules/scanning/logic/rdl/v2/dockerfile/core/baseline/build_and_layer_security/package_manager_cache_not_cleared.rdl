VERSION 2
RULE baseline.dockerfile.core.package_manager_cache_not_cleared VERSION 1
IN FILE
WHEN TEXT_MATCHES "^RUN\\s+(?:apt-get\\s+install|yum\\s+install|apk\\s+add|dnf\\s+install)" "im"
WHEN TEXT_MISSING "rm\\s+-rf|clean\\s+all|--no-cache" "im"
REPORT "Package Manager Cache Not Cleared"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
