VERSION 2
RULE baseline.mobile.android.core.review_android_hostname_verifier_always_true VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\b(?:setHostnameVerifier\\s*\\(\\s*\\([^)]{0,160}\\)\\s*->\\s*true|hostnameVerifier\\s*=\\s*HostnameVerifier\\s*\\{[^}]{0,160}->\\s*true\\s*\\})" "im"
REPORT "TLS Hostname Validation Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
