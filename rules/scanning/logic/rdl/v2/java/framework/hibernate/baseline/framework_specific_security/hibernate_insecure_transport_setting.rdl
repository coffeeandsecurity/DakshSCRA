VERSION 2
RULE baseline.java.framework.hibernate.hibernate_insecure_transport_setting VERSION 1
IN FILE
WHEN TEXT_MATCHES "http://|server\\.ssl\\.enabled\\s*=\\s*false|allowInsecureProtocol\\s*=\\s*true" "im"
WHEN TEXT_MISSING "https://" "im"
REPORT "Cleartext HTTP Communication Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
