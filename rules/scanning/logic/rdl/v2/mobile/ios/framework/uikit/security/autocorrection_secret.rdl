VERSION 2
RULE ios.uikit.autocorrection-secret VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)\\b(?:password|passwd|pin|secret|token)\\w*\\s*\\.\\s*autocorrectionType\\s*=\\s*(?:\\.yes|UITextAutocorrectionTypeYes)\\b" ""
REPORT "Sensitive Input Autocorrection Explicitly Enabled"
SEVERITY MEDIUM
CONFIDENCE LOW
WITH TRACE
