VERSION 2
RULE android.high-risk-package-permission VERSION 1
IN FILE
WHEN TEXT_MATCHES "<uses-permission(?:-sdk-23)?\\b[^>]{0,500}\\b[A-Za-z_][\\w.-]*:name\\s*=\\s*[\"\\x27](?:android\\.permission\\.REQUEST_INSTALL_PACKAGES|android\\.permission\\.QUERY_ALL_PACKAGES)[\"\\x27]" ""
REPORT "Package Management Capability"
SEVERITY MEDIUM
CONFIDENCE LOW
WITH TRACE
