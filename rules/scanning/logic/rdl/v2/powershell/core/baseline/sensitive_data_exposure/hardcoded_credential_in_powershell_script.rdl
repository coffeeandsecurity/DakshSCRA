VERSION 2
RULE baseline.powershell.core.hardcoded_credential_in_powershell_script VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)(?:password|passwd|secret|apikey|api_key|token|accesskey)\\s*=\\s*[\"'][A-Za-z0-9@#$%^&*!_\\-]{8,}[\"']" "im"
WHEN TEXT_MISSING "SecureString|Get-Secret|Vault|\\$env:" "im"
REPORT "Hardcoded Credential in PowerShell Script"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
