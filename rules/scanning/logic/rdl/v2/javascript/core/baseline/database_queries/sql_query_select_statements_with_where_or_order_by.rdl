VERSION 2
RULE baseline.javascript.core.sql_query_select_statements_with_where_or_order_by VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)\\bSELECT\\s+?\\*?\\s+?FROM\\s+[^\\s]+\\s+(WHERE|ORDER BY)\\b.*" "im"
WHEN (TEXT_MATCHES "(\\+|`|\\$\\{|req\\.|params|query|body)" "im" AND TEXT_MISSING "(\\?|prepare|bind|replacements|sequelize\\.query\\s*\\(.*replacements)" "im")
REPORT "SQL Query: SELECT Statements with WHERE or ORDER BY"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
