VERSION 2
RULE baseline.mobile.android.core.review_android_overlay_permission VERSION 1
IN FILE
WHEN TEXT_MATCHES "<uses-permission(?:-sdk-23)?\\b[^>]{0,500}\\b[A-Za-z_][\\w.-]*:name\\s*=\\s*[\"\\x27](?:android\\.permission\\.SYSTEM_ALERT_WINDOW)[\"\\x27]" "im"
REPORT "Cross-Application Overlay Capability"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
