VERSION 2
RULE android.broad-storage-permission VERSION 1
IN FILE
WHEN TEXT_MATCHES "<uses-permission(?:-sdk-23)?\\b[^>]{0,500}\\b[A-Za-z_][\\w.-]*:name\\s*=\\s*[\"\\x27](?:android\\.permission\\.MANAGE_EXTERNAL_STORAGE)[\"\\x27]" ""
REPORT "Broad External Storage Capability"
SEVERITY MEDIUM
CONFIDENCE LOW
WITH TRACE
