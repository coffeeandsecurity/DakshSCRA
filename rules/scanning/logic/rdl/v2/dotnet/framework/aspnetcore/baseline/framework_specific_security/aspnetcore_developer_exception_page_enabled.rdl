VERSION 2
RULE baseline.dotnet.framework.aspnetcore.aspnetcore_developer_exception_page_enabled VERSION 1
IN FILE
WHEN TEXT_MATCHES "UseDeveloperExceptionPage\\(\\)" "im"
WHEN (TEXT_MISSING "app\\.Environment\\.IsProduction\\(\\)|ASPNETCORE_ENVIRONMENT.*Production|IsDevelopment\\(\\).*false" "im" AND TEXT_MATCHES "UseDeveloperExceptionPage\\s*\\(\\s*\\)" "im")
REPORT "Developer Exception Page Enabled"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
