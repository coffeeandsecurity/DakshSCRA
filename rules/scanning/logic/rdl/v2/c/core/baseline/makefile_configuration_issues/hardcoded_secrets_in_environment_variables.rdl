VERSION 2
RULE baseline.c.core.hardcoded_secrets_in_environment_variables VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)export\\s+(?:PASSWORD|SECRET|API_KEY|APIKEY|TOKEN|ACCESS_KEY|PRIVATE_KEY|AUTH_TOKEN|PASSWD|CREDENTIAL)\\s*=\\s*\\S" "im"
REPORT "Hardcoded Secrets in Environment Variables"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
