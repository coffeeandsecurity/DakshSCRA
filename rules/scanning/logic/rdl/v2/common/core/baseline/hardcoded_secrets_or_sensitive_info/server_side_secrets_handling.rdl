VERSION 2
RULE baseline.common.core.server_side_secrets_handling VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)\\b(apikey|api(?:-|_)?key|secret|token|access_token|auth_token|client_secret|private_key|encryption_key|db_password|security_key|session_key|service_account_key|passphrase|cert_key|app_secret|api_secret|jwt_secret)\\b\\s*[:=]\\s*[\"'][^\"']{8,}[\"']" "im"
WHEN TEXT_MISSING "(?i)\\b(example|sample|dummy|test|placeholder|mock|getenv|env\\(|secretsmanager|vault|kms|buildconfig|gradle\\.properties)\\b" "im"
REPORT "Server-Side Secret Handling Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
