VERSION 2
RULE baseline.cpp.framework.boost.boost_unsafe_memory_string_api VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\b(strcpy|strcat|sprintf|gets|memcpy)\\s*\\(" "im"
WHEN (TEXT_MISSING "boost::algorithm::trim|boost::range|size\\s*\\(|bounds|length" "im" AND TEXT_MISSING "test|example" "im")
REPORT "Buffer Bounds Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
