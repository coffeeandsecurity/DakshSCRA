VERSION 2
RULE baseline.cpp.core.unsafe_use_of_command_execution_functions VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\b(?:system|popen|exec|execl|execv|execle|execve|execlp|execvp|execvpe|execp|CreateProcess(?:A|W)?|ShellExecute(?:Ex)?(?:A|W)?|WinExec|(?:g_)?spawn_command_line_(?:async|sync))\\s*\\(" "im"
REPORT "OS Command Injection Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
