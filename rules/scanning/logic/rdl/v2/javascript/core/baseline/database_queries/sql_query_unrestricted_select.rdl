VERSION 2
RULE baseline.javascript.core.sql_query_unrestricted_select VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\bSELECT\\s+\\*\\s+FROM\\b" "im"
WHEN (TEXT_MISSING "LIMIT\\s+\\d+|pagination|rownum|TOP\\s+\\d+|fetchSize" "im" AND TEXT_MISSING "test|example" "im")
REPORT "Database Column Selection Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
