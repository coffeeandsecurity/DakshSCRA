VERSION 2
RULE baseline.filepaths.core.libraries_extensions_plugins VERSION 1
IN PATH
WHEN TEXT_MATCHES "(?i)(Libraries|Extension|Plugin)" "im"
WHEN TEXT_MATCHES "(?i)(/|\\\\\\\\).*(lib|libs|extension|plugin|addons?)" "im"
REPORT "Libraries | Extensions | Plugins"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
