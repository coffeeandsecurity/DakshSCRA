VERSION 2
RULE baseline.ruby.core.cookies_missing_secure_or_httponly_flags VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\bcookies\\[[^\\]]+\\]\\s*=\\s*\\{(?![^\\}]*\\b(?:secure|httponly)\\b)" "im"
WHEN (TEXT_MISSING "secure:\\s*true|httponly:\\s*true|SameSite|HttpOnly" "im" AND TEXT_MATCHES "cookies\\[.*\\]\\s*=\\s*\\{" "im")
REPORT "Cookies Missing Secure or HttpOnly Flags"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
