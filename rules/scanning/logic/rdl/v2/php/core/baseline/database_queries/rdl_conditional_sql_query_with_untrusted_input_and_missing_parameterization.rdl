VERSION 2
RULE baseline.php.core.rdl_conditional_sql_query_with_untrusted_input_and_missing_parameterization VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)\\b(?:mysql_query|mysqli_query|pg_query|sqlite_query|->query)\\s*\\(" "im"
WHEN TEXT_MATCHES "\\$_(GET|POST|REQUEST|COOKIE)|\\.\\s*\\$|sprintf\\s*\\(|format\\s*\\(" "im"
REPORT "SQL Injection Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
