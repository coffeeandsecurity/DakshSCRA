VERSION 2
RULE baseline.mobile.xplat.maui.core.review_maui_secure_storage_plaintext_fallback VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\bPreferences(?:\\.Default)?\\.Set\\s*\\(\\s*[\"\\x27](?:password|token|secret|credential)[\"\\x27]" "im"
REPORT "Secure Storage Fallback Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
