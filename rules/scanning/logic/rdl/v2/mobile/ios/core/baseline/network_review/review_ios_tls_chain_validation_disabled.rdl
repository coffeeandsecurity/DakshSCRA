VERSION 2
RULE baseline.mobile.ios.core.review_ios_tls_chain_validation_disabled VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\bkCFStreamSSLValidatesCertificateChain\\s*(?:\\]\\s*=|:|=)\\s*(?:false\\b|kCFBooleanFalse\\b|@NO\\b)" "im"
REPORT "TLS Certificate Validation Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
