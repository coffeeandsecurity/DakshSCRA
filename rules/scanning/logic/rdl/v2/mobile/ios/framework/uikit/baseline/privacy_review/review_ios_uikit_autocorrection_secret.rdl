VERSION 2
RULE baseline.mobile.ios.framework.uikit.review_ios_uikit_autocorrection_secret VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)\\b(?:password|passwd|pin|secret|token)\\w*\\s*\\.\\s*autocorrectionType\\s*=\\s*(?:\\.yes|UITextAutocorrectionTypeYes)\\b" "im"
REPORT "Sensitive Input Prediction Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
