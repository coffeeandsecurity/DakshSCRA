VERSION 2
RULE baseline.dotnet.core.untrusted_data_output_httpcontext_current_request_form VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\.Append\\(.*HttpContext\\.Current\\.Request\\.Form" "im"
WHEN TEXT_MISSING "(HtmlEncode|UrlEncode|Sanitize|AntiXssEncoder)" "im"
REPORT "Untrusted Input Entry Point"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
