VERSION 2
RULE baseline.mobile.ios.core.insecure_random_number_generation VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\barc4random\\s*\\(|\\barc4random_uniform\\s*\\(|\\brand\\s*\\(" "im"
WHEN (TEXT_MATCHES "token|key|secret|nonce|session|otp|password|salt" "im" AND TEXT_MISSING "SecRandomCopyBytes|CryptorRandomByte|CCRandomGenerateBytes" "im")
REPORT "Insecure Random Number Generation"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
