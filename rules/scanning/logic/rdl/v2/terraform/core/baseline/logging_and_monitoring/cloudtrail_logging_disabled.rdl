VERSION 2
RULE baseline.terraform.core.cloudtrail_logging_disabled VERSION 1
IN FILE
WHEN TEXT_MATCHES "resource\\s+\"aws_cloudtrail\"[^}]*enable_logging\\s*=\\s*false" "im"
WHEN (TEXT_MATCHES "enable_logging\\s*=\\s*false|is_logging\\s*=\\s*false|enabled\\s*=\\s*false" "im" AND TEXT_MISSING "# intentional|# cost|# development" "im")
REPORT "CloudTrail Logging Disabled"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
