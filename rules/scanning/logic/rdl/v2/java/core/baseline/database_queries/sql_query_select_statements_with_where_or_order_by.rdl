VERSION 2
RULE baseline.java.core.sql_query_select_statements_with_where_or_order_by VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)\\bSELECT\\s+?\\*?\\s+?FROM\\s+[^\\s]+\\s+(WHERE|ORDER BY)\\b.*" "im"
WHEN (TEXT_MATCHES "(\\+|String\\.format|MessageFormat|requestParameters|getParameter)" "im" AND TEXT_MISSING "PreparedStatement|setString\\(|setInt\\(|setLong\\(|setObject\\(" "im")
REPORT "SQL Query Construction Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
