VERSION 2
RULE android.hostname-verifier-always-true VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\b(?:setHostnameVerifier\\s*\\(\\s*\\([^)]{0,160}\\)\\s*->\\s*true|hostnameVerifier\\s*=\\s*HostnameVerifier\\s*\\{[^}]{0,160}->\\s*true\\s*\\})" ""
REPORT "TLS Hostname Validation Review"
SEVERITY MEDIUM
CONFIDENCE LOW
WITH TRACE
