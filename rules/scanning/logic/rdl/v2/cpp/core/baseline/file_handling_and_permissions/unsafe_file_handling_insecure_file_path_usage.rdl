VERSION 2
RULE baseline.cpp.core.unsafe_file_handling_insecure_file_path_usage VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\b(?:ifstream|ofstream|fstream)\\b.*\\.open\\s*\\(.*\\)" "im"
WHEN TEXT_MISSING "validate|sanitize|canonical|realpath|filesystem::path" "im"
REPORT "File Path and Access Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
