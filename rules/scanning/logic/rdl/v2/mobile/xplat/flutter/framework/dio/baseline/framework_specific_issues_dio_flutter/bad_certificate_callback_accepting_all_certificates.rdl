VERSION 2
RULE baseline.mobile.xplat.flutter.framework.dio.bad_certificate_callback_accepting_all_certificates VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\b(?:badCertificateCallback\\s*[:=]|onBadCertificate\\s*:)\\s*\\([^)]*\\)\\s*(?:=>\\s*true\\b|\\{\\s*return\\s+true\\b)" "im"
REPORT "TLS Certificate Validation Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
