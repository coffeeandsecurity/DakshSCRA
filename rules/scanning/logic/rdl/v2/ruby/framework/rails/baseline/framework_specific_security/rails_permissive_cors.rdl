VERSION 2
RULE baseline.ruby.framework.rails.rails_permissive_cors VERSION 1
IN FILE
WHEN TEXT_MATCHES "origins\\s+[\\'\\\"]\\*[\\'\\\"]|Access-Control-Allow-Origin\\s*=\\s*[\\'\\\"]\\*[\\'\\\"]" "im"
WHEN TEXT_MISSING "allowlist|whitelist|trusted" "im"
REPORT "Rails Permissive CORS"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
