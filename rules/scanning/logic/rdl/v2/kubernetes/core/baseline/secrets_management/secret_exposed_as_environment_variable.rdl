VERSION 2
RULE baseline.kubernetes.core.secret_exposed_as_environment_variable VERSION 1
IN FILE
WHEN TEXT_MATCHES "secretKeyRef\\s*:|valueFrom\\s*:[^}]*secretKeyRef" "im"
WHEN TEXT_MISSING "volumes\\s*:|volumeMounts\\s*:" "im"
REPORT "Secret Exposed as Environment Variable"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
