VERSION 2
RULE baseline.python.core.ssrf_requests_library_with_user_controlled_url VERSION 1
IN FILE
WHEN TEXT_MATCHES "requests\\.(get|post|put|delete|patch|head|request)\\s*\\(" "im"
WHEN (TEXT_MATCHES "request\\.GET|request\\.POST|request\\.args|request\\.form|input\\(|argv|\\+" "im" AND TEXT_MISSING "allowlist|whitelist|urlparse|ipaddress|is_private|validators\\.url" "im")
REPORT "Server-Side Request Forgery Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
