VERSION 2
RULE baseline.python.framework.fastapi.fastapi_unsafe_deserialization VERSION 1
IN FILE
WHEN TEXT_MATCHES "pickle\\.loads\\(|yaml\\.load\\(\\s*[^,\\)]*\\)|marshal\\.loads\\(" "im"
WHEN TEXT_MISSING "yaml\\.safe_load|Loader=SafeLoader|trusted|allowlist|from_trusted_source" "im"
REPORT "Fastapi Unsafe Deserialization"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
