VERSION 2
RULE baseline.kubernetes.core.default_service_account_token_auto_mounted VERSION 1
IN FILE
WHEN TEXT_MATCHES "automountServiceAccountToken\\s*:\\s*true" "im"
WHEN (TEXT_MISSING "automountServiceAccountToken:\\s*false" "im" AND TEXT_MATCHES "kind:\\s*Deployment|kind:\\s*StatefulSet|kind:\\s*Pod|kind:\\s*DaemonSet" "im")
REPORT "Default Service Account Token Auto-Mounted"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
