VERSION 2
RULE baseline.terraform.framework.azure.azure_sql_server_allows_all_azure_services VERSION 1
IN FILE
WHEN TEXT_MATCHES "start_ip_address\\s*=\\s*\"0\\.0\\.0\\.0\"[^}]*end_ip_address\\s*=\\s*\"0\\.0\\.0\\.0\"" "im"
WHEN (TEXT_MATCHES "start_ip_address\\s*=\\s*\"0\\.0\\.0\\.0\".*end_ip_address\\s*=\\s*\"0\\.0\\.0\\.0\"" "im" AND TEXT_MISSING "# intentional|# development|firewall_rule" "im")
REPORT "Azure SQL Server Allows All Azure Services"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
