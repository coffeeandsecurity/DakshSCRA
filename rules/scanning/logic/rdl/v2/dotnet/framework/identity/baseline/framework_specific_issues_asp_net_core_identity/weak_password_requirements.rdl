VERSION 2
RULE baseline.dotnet.framework.identity.weak_password_requirements VERSION 1
IN FILE
WHEN TEXT_MATCHES "RequiredLength\\s*=\\s*[1-7]\\b|RequireDigit\\s*=\\s*false|RequireUppercase\\s*=\\s*false" "im"
WHEN (TEXT_MATCHES "RequiredLength\\s*=\\s*[1-7]\\b|RequireDigit\\s*=\\s*false|RequireUppercase\\s*=\\s*false|RequireLowercase\\s*=\\s*false" "im" AND TEXT_MISSING "test|example" "im")
REPORT "Password Policy Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
