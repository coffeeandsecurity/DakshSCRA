VERSION 2
RULE baseline.mobile.xplat.kmp.core.review_kmp_ios_trust_callback VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\b(?:NSURLSessionAuthChallengeUseCredential|useCredential)\\b[^\\n]{0,200}\\b(?:NSURLCredential|credentialForTrust)\\b" "im"
REPORT "TLS Certificate Validation Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
