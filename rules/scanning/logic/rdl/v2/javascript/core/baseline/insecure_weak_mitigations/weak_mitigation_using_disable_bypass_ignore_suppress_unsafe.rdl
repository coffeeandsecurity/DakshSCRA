VERSION 2
RULE baseline.javascript.core.weak_mitigation_using_disable_bypass_ignore_suppress_unsafe VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\b(disable|bypass|ignore|suppress|unsafe)\\b" "im"
WHEN (TEXT_MATCHES "(auth|csrf|xss|cors|tls|ssl|verify|validation|sanitize|security)" "im" AND TEXT_MISSING "(example|sample|dummy|test|placeholder)" "im")
REPORT "Weak Mitigation: Using disable|bypass|ignore|suppress|unsafe"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
