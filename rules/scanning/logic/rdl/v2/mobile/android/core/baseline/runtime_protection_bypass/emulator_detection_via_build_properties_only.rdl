VERSION 2
RULE baseline.mobile.android.core.emulator_detection_via_build_properties_only VERSION 1
IN FILE
WHEN TEXT_MATCHES "Build\\.FINGERPRINT\\.contains\\s*\\(|Build\\.MODEL\\.contains\\s*\\(\\s*\"(?:google_sdk|Emulator|Android SDK)\"" "im"
REPORT "Emulator Detection via Build Properties Only"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
