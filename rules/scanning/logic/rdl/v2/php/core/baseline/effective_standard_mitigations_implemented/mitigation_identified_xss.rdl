VERSION 2
RULE baseline.php.core.mitigation_identified_xss VERSION 1
IN FILE
WHEN TEXT_MATCHES "htmlentities" "im"
WHEN (TEXT_MATCHES "htmlspecialchars|htmlentities|strip_tags|esc_html|h\\s*\\(" "im" AND TEXT_MISSING "test|example" "im")
REPORT "Mitigation Identified: XSS"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
