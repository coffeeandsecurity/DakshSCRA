VERSION 2
RULE baseline.php.framework.symfony.symfony_dangerous_dynamic_eval_template_execution VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\beval\\s*\\(|assert\\s*\\(\\s*\\$|create_function\\s*\\(" "im"
WHEN TEXT_MISSING "validate|allowlist|trusted|twig|test|example" "im"
REPORT "Symfony Dangerous Dynamic Eval/Template Execution"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
