VERSION 2
RULE baseline.java.core.sql_query_non_parameterized_delete_statements VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)\\bDELETE\\s+FROM\\s+[^\\s]+\\s+WHERE\\s+.*=.*\\$.*" "im"
WHEN TEXT_MISSING "PreparedStatement|setString\\(|setInt\\(|setLong\\(|setObject\\(" "im"
REPORT "SQL Parameterization Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
