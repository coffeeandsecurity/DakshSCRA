VERSION 2
RULE baseline.mobile.android.framework.jetpack.android_webview_file_url_universal_access VERSION 1
IN FILE
WHEN TEXT_MATCHES "setAllowUniversalAccessFromFileURLs\\(\\s*true\\s*\\)|setAllowFileAccessFromFileURLs\\(\\s*true\\s*\\)" "im"
