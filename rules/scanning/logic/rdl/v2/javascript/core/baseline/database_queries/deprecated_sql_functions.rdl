VERSION 2
RULE baseline.javascript.core.deprecated_sql_functions VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?is)\\b(?:mysql_query|pg_query|sqlite_query|db\\.query|db\\.execute|knex\\.raw)\\s*\\(\\s*(?:['\"`]\\s*(?:SELECT|INSERT|UPDATE|DELETE)\\b|(?:SELECT|INSERT|UPDATE|DELETE)\\b)" "im"
WHEN (TEXT_MATCHES "(?i)(\\+|`|\\$\\{|req\\.|params|query|body|userInput|input)" "im" AND TEXT_MISSING "(?i)(\\?|prepare|bind|replacements|parameterized|sequelize\\.query\\s*\\([^)]*replacements|mysql\\.escape|pg\\.escape)" "im" AND TEXT_MISSING "(?i)test|example|spec|fixture|mock" "im")
REPORT "Deprecated SQL Functions"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
