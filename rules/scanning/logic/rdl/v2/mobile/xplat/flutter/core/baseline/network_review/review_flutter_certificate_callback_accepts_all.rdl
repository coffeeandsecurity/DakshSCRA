VERSION 2
RULE baseline.mobile.xplat.flutter.core.review_flutter_certificate_callback_accepts_all VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\bbadCertificateCallback\\s*=\\s*\\([^)]{0,300}\\)\\s*(?:=>\\s*true\\b|\\{\\s*return\\s+true\\b)" "im"
REPORT "TLS Certificate Validation Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
