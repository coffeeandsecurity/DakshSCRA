VERSION 2
RULE baseline.terraform.core.hardcoded_secret_or_password_in_terraform_variables VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)(?:password|secret|api_key|apikey|token|private_key)\\s*=\\s*\"[A-Za-z0-9@#$%^&*!_\\-]{8,}\"" "im"
REPORT "Hardcoded Credential or Secret Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
