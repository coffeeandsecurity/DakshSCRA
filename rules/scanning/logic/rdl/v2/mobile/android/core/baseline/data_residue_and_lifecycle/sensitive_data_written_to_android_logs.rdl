VERSION 2
RULE baseline.mobile.android.core.sensitive_data_written_to_android_logs VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)Log\\.[dviweVIWDE]\\s*\\((?:[^\\n]*|[^;{}]*?)(?:password|token|secret|apiKey|credential|authToken|accessToken|bearer|ssn|card)" "im"
REPORT "Sensitive Data Logging Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
