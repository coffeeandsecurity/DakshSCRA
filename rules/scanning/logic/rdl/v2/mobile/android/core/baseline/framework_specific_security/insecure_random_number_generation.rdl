VERSION 2
RULE baseline.mobile.android.core.insecure_random_number_generation VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\bnew\\s+Random\\s*\\(\\s*\\)|\\bMath\\.random\\s*\\(\\s*\\)" "im"
WHEN (TEXT_MATCHES "token|key|secret|nonce|session|otp|password|salt" "im" AND TEXT_MISSING "SecureRandom" "im")
REPORT "Insecure Random Number Generation"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
