VERSION 2
RULE baseline.php.core.ssrf_curl_exec_with_user_controlled_url VERSION 1
IN FILE
WHEN TEXT_MATCHES "curl_setopt\\s*\\(\\s*\\$\\w+\\s*,\\s*CURLOPT_URL|curl_init\\s*\\(\\s*[^\\s)]|\\bCURLOPT_URL\\s*=>" "im"
REPORT "Outbound Request Destination Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
