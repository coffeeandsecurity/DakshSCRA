VERSION 2
RULE baseline.c.framework.freertos.freertos_insecure_transport_cert_bypass_marker VERSION 1
IN FILE
WHEN TEXT_MATCHES "CURLOPT_SSL_VERIFYPEER\\s*,\\s*0|CURLOPT_SSL_VERIFYHOST\\s*,\\s*0" "im"
WHEN TEXT_MISSING "test|development|staging" "im"
REPORT "TLS Certificate Validation Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
