VERSION 2
RULE baseline.cpp.core.c_style_variadic_functions_potential_for_type_safety_issues VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\b(__attribute__\\s*\\(\\s*format\\s*\\(\\s*__variadic\\s*,)" "im"
WHEN (TEXT_MATCHES "va_list|va_start|va_arg|va_end" "im" AND TEXT_MISSING "vsnprintf|type_safe|fmt::|std::format" "im" AND TEXT_MISSING "test|example" "im")
REPORT "C-style Variadic Functions: Potential for Type Safety Issues"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
