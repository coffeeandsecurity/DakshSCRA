VERSION 2
RULE baseline.mobile.xplat.flutter.framework.hive.hive_encryption_key_stored_insecurely VERSION 1
IN FILE
WHEN TEXT_MATCHES "HiveAesCipher\\s*\\(|Hive\\.generateSecureKey\\s*\\(\\s*\\)" "im"
WHEN TEXT_MISSING "flutter_secure_storage|FlutterSecureStorage|SecureStoragePlugin" "im"
REPORT "Hive Encryption Key Stored Insecurely"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
