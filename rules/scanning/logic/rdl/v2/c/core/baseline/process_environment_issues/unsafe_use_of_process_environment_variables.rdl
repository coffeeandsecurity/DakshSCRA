VERSION 2
RULE baseline.c.core.unsafe_use_of_process_environment_variables VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\b(getenv|setenv|putenv|clearenv)\\s*\\(" "im"
WHEN TEXT_MISSING "validate|sanitize|allowlist|whitelist|check\\s*\\(|strlen|strnlen" "im"
REPORT "Unsafe Use of Process Environment Variables"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
