VERSION 2
RULE baseline.common.core.sql_query_select_statement_with_order_by_and_inputname VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)\\bSELECT\\b.*\\bORDER BY\\b.*\\s@\\w+" "im"
WHEN TEXT_MATCHES "(?i)\\b(exec|sp_executesql|query|command)\\b" "im"
REPORT "SQL Sorting Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
