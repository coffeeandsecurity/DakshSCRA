VERSION 2
RULE baseline.terraform.framework.aws.lambda_environment_variable_contains_secret VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)(?:password|secret|api_key|token)\\s*=\\s*\"[^\"]{8,}\"" "im"
WHEN TEXT_MISSING "aws_secretsmanager|var\\.|data\\." "im"
REPORT "Lambda Environment Variable Contains Secret"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
