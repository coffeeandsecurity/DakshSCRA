VERSION 2
RULE baseline.mobile.android.core.review_android_sensitive_preference_write VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)\\b(?P<receiver>[A-Za-z_]\\w*)\\s*\\.\\s*putString\\s*\\(\\s*\"(?:password|passwd|token|access_token|refresh_token|secret|credential)\"\\s*,\\s*(?P<value>[^;\\n]{1,200})\\)" "im"
REPORT "Preferences Data Storage Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
