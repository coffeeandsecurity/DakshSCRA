VERSION 2
RULE baseline.common.core.sensitive_debug_information VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)\\.debug\\s*=\\s*True|\\$debug\\s*=\\s*true|DEBUG\\s*=\\s*True|IsDebuggingEnabled\\s*=\\s*true" "im"
WHEN TEXT_MISSING "(?i)\\b(release|production)\\b" "im"
REPORT "Debug Information Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
