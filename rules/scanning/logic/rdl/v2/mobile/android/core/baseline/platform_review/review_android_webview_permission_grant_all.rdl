VERSION 2
RULE baseline.mobile.android.core.review_android_webview_permission_grant_all VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\b(?P<receiver>\\w+)\\s*\\.\\s*grant\\s*\\(\\s*(?P=receiver)\\s*\\.\\s*(?:getResources\\s*\\(\\s*\\)|resources\\b)\\s*\\)" "im"
REPORT "WebView Permission Policy Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
