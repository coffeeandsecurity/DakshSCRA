VERSION 2
RULE baseline.common.core.backdoor_entry_and_bypass_detection VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)\\b(?:backdoor|auth(?:entication|orization)?[_ -]?bypass|bypass[_ -]?(?:auth(?:entication|orization)?|permission|access[_ -]?control)|unauthorized_access|unauthorized_entry|hidden_entry|stealthy_entry|secret_entry)\\b" "im"
WHEN TEXT_MISSING "(?i)\\b(example|sample|dummy|test|placeholder|ctf|training)\\b" "im"
REPORT "Security Control Bypass Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
