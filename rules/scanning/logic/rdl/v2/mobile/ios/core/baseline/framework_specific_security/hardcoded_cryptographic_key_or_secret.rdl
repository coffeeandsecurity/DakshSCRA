VERSION 2
RULE baseline.mobile.ios.core.hardcoded_cryptographic_key_or_secret VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)(apiKey|api_key|secret|privateKey|encryptionKey|password|token)\\s*[:=]\\s*[\"'][A-Za-z0-9/+]{16,}[\"']" "im"
REPORT "Hardcoded Cryptographic Key Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
