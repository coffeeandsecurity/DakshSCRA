VERSION 2
RULE baseline.common.core.trusted_or_untrusted_urls VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)https?://" "im"
WHEN (TEXT_MATCHES "(?i)\\b(redirect|forward|window\\.location|location\\.href|window\\.open|fetch|axios|httpclient|request|url|uri|endpoint)\\b" "im" AND TEXT_MATCHES "(?i)(\\+|\\$\\{|request|params|query|input|user)" "im" AND TEXT_MISSING "(?i)\\b(allowlist|whitelist|trusted|isTrusted|validateUrl|same-origin)\\b" "im")
REPORT "Trusted Or Untrusted URLs"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
