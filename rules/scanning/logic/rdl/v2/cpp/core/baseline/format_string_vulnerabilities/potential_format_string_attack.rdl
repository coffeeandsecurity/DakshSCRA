VERSION 2
RULE baseline.cpp.core.potential_format_string_attack VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\b(printf|fprintf|sprintf|vsprintf)\\s*\\(\\s*[^\"]+\\s*," "im"
WHEN (TEXT_MISSING "\"%s\"|\"%d\"|\"%f\"|\"%i\"|\"%u\"|\"%x\"" "im" AND TEXT_MISSING "const\\s+char\\s*\\*\\s*format" "im")
REPORT "Potential Format String Attack"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
