VERSION 2
RULE baseline.dotnet.framework.aspnetcore.aspnetcore_insecure_certificate_validation_callback VERSION 1
IN FILE
WHEN TEXT_MATCHES "ServerCertificateCustomValidationCallback\\s*=\\s*\\(.*=>\\s*true" "im"
WHEN TEXT_MISSING "test|development|localhost|staging" "im"
REPORT "Aspnetcore Insecure Certificate Validation Callback"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
