VERSION 2
RULE baseline.mobile.xplat.nativescript.core.nativescript_hardcoded_secret_marker VERSION 1
IN FILE
WHEN TEXT_MATCHES "(api[_-]?key|secret|token|password)\\s*[:=]\\s*[\\'\\\"][^\\'\\\"]{8,}[\\'\\\"]" "im"
REPORT "NativeScript Hardcoded Secret Marker"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
