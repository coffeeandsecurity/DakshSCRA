VERSION 2
RULE baseline.mobile.ios.framework.swiftui.swiftui_sensitive_data_in_userdefaults_marker VERSION 1
IN FILE
WHEN TEXT_MATCHES "UserDefaults\\.standard\\.set\\((?:[^\\n]*|[^;{}]*?)(token|secret|password|apikey)" "im"
REPORT "Preferences Data Storage Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
