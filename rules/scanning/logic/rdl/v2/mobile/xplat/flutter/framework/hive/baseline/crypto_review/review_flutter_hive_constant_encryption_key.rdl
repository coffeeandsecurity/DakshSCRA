VERSION 2
RULE baseline.mobile.xplat.flutter.framework.hive.review_flutter_hive_constant_encryption_key VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\bHiveAesCipher\\s*\\(\\s*(?:List(?:<int>)?\\.filled\\s*\\(|\\[\\s*\\d)" "im"
REPORT "Hive Uses a Constant Encryption Key"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
