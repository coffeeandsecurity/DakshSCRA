VERSION 2
RULE baseline.filepaths.core.purchases_ordering VERSION 1
IN PATH
WHEN TEXT_MATCHES "(?-i:(?:(?<![A-Za-z0-9])(?i:purchases?|purchasing|orders?|ordering|cart|checkout)(?=[A-Z_. /\\\\-]|$)|(?<=[a-z0-9])(?:Purchases?|Purchasing|Orders?|Ordering|Cart|Checkout)(?=[A-Z_. /\\\\-]|$)))" "im"
WHEN TEXT_MISSING "(?i)(/docs?/|/examples?/|/samples?/|/tests?/)" "im"
REPORT "Ordering Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
