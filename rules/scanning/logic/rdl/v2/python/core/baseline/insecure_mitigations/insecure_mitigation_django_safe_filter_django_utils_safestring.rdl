VERSION 2
RULE baseline.python.core.insecure_mitigation_django_safe_filter_django_utils_safestring VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)\\.safestring" "im"
WHEN (TEXT_MISSING "escape|bleach\\.clean|html\\.escape|strip_tags|validate" "im" AND TEXT_MISSING "test|example" "im")
REPORT "HTML Output Encoding Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
