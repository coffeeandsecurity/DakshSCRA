VERSION 2
RULE baseline.javascript.framework.express.express_sql_nosql_injection_sink VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\.(query|execute)\\(\\s*`|\\$where\\s*:\\s*|sequelize\\.query\\(" "im"
WHEN TEXT_MISSING "prepare|parameterize|escape|\\?.*params|mysql\\.escape|knex|sequelize" "im"
REPORT "Express SQL/NoSQL Injection Sink"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
