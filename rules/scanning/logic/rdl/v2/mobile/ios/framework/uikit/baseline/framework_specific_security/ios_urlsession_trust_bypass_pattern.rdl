VERSION 2
RULE baseline.mobile.ios.framework.uikit.ios_urlsession_trust_bypass_pattern VERSION 1
IN FILE
WHEN TEXT_MATCHES "didReceive\\s+challenge(?:[^\\n]*|[^;{}]*?)completionHandler\\(\\.useCredential|allowInvalidCertificates" "im"
REPORT "TLS Certificate Validation Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
