VERSION 2
RULE baseline.python.core.command_injection_eval VERSION 1
IN FILE
WHEN TEXT_MATCHES "(^|\\s|=\\s?)eval\\(" "im"
WHEN (TEXT_MATCHES "(input\\(|request|params|query|user_input|base64|pickle)" "im" AND TEXT_MISSING "(allowlist|whitelist)" "im")
REPORT "Command Injection: eval()"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
