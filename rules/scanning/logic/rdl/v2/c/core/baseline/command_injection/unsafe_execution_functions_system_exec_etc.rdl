VERSION 2
RULE baseline.c.core.unsafe_execution_functions_system_exec_etc VERSION 1
IN FILE
WHEN TEXT_MATCHES "^\\s*(?:int|void|char|size_t|auto)?\\s*\\*?\\s*\\w+\\s*=\\s*\\b(system|exec|popen|execl)\\s*\\(.*\\)" "im"
WHEN TEXT_MISSING "validate|sanitize|allowlist|whitelist|escapeShellArg" "im"
REPORT "Unsafe Execution Functions: system(), exec(), etc."
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
