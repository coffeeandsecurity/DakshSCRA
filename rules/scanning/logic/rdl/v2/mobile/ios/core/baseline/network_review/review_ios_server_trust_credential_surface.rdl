VERSION 2
RULE baseline.mobile.ios.core.review_ios_server_trust_credential_surface VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\b(?:URLCredential\\s*\\(\\s*trust\\s*:|credentialForTrust\\s*:|SecTrustSetExceptions\\s*\\()" "im"
REPORT "TLS Certificate Validation Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
