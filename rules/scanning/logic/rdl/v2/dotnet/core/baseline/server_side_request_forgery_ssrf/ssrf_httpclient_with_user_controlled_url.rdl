VERSION 2
RULE baseline.dotnet.core.ssrf_httpclient_with_user_controlled_url VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\b[A-Za-z_]\\w*\\s*\\.\\s*(?:GetAsync|PostAsync|PutAsync|DeleteAsync|SendAsync|GetStringAsync|GetByteArrayAsync)\\s*\\(" "im"
REPORT "Server-Side Request Forgery Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
