VERSION 2
RULE ios.runtime-method-hooking VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\b(?:method_exchangeImplementations|method_setImplementation|class_replaceMethod|MSHookFunction|MSHookMessageEx|fishhook|rebind_symbols)\\s*\\(" ""
REPORT "Objective-C Runtime Method Hooking"
SEVERITY MEDIUM
CONFIDENCE LOW
WITH TRACE
