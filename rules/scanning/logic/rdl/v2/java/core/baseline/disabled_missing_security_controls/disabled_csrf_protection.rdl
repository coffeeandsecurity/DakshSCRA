VERSION 2
RULE baseline.java.core.disabled_csrf_protection VERSION 1
IN FILE
WHEN TEXT_MATCHES "(\\b.disable\\(\\s*['\"]csrf['\"]\\s*\\))" "im"
WHEN (TEXT_MISSING "CsrfTokenRepository|csrfTokenRequestAttributeName|SameSite" "im" AND TEXT_MATCHES "csrf\\(\\)\\.disable\\(\\)|csrf\\.disable\\(\\)|CsrfConfigurer" "im")
REPORT "Disabled CSRF Protection"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
