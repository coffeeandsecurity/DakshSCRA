VERSION 2
RULE baseline.mobile.xplat.reactnative.core.review_reactnative_sensitive_console VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)\\bconsole\\.(?:log|debug|info|warn|error)\\s*\\([^\\n;]{0,200}\\b(?:password|token|secret|credential)\\b" "im"
REPORT "Sensitive Data Logging Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
