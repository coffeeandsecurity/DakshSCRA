VERSION 2
RULE baseline.kotlin.framework.springkotlin.springkotlin_sql_injection_sink VERSION 1
IN FILE
WHEN TEXT_MATCHES "rawQuery\\(\\s*\"[^\"]*\"\\s*\\+|execSQL\\(\\s*\"[^\"]*\"\\s*\\+" "im"
WHEN TEXT_MISSING "prepareStatement|setString\\s*\\(|setInt\\s*\\(|NamedParameterJdbcTemplate|\\?|bindParam" "im"
REPORT "SQL Injection Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
