VERSION 2
RULE baseline.mobile.xplat.flutter.core.flutter_shared_preferences_secret_marker VERSION 1
IN FILE
WHEN TEXT_MATCHES "setString\\(\\s*[\\'\\\"].*(token|secret|password|apikey)" "im"
WHEN TEXT_MISSING "flutter_secure_storage|secure_storage" "im"
REPORT "Flutter Shared Preferences Secret Marker"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
