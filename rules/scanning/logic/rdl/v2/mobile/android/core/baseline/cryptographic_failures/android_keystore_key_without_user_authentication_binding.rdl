VERSION 2
RULE baseline.mobile.android.core.android_keystore_key_without_user_authentication_binding VERSION 1
IN FILE
WHEN TEXT_MATCHES "KeyGenParameterSpec\\.Builder\\s*\\(" "im"
WHEN TEXT_MISSING "setUserAuthenticationRequired\\s*\\(\\s*true|setUserAuthenticationParameters|setUnlockedDeviceRequired\\s*\\(\\s*true" "im"
REPORT "Android KeyStore Key Without User Authentication Binding"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
