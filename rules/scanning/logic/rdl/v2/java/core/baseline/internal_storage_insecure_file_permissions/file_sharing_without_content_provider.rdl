VERSION 2
RULE baseline.java.core.file_sharing_without_content_provider VERSION 1
IN FILE
WHEN TEXT_MATCHES "Intent\\s*\\(\\s*(?:[^,]*,\\s*)?Uri\\.parse" "im"
WHEN TEXT_MISSING "FileProvider|FLAG_GRANT_READ_URI_PERMISSION|content://" "im"
REPORT "Outgoing URI Intent Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
