VERSION 2
RULE baseline.cpp.framework.boost.boost_tls_validation_bypass_marker VERSION 1
IN FILE
WHEN TEXT_MATCHES "ignoreSslErrors\\(\\)|setPeerVerifyMode\\(\\s*QSslSocket::VerifyNone" "im"
WHEN TEXT_MISSING "test|development|localhost|staging" "im"
REPORT "TLS Certificate Validation Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
