VERSION 2
RULE baseline.mobile.ios.framework.uikit.ios_urlsession_trust_bypass_pattern VERSION 1
IN FILE
WHEN TEXT_MATCHES "didReceive\\s+challenge.*completionHandler\\(\\.useCredential|allowInvalidCertificates" "im"
WHEN TEXT_MISSING "SecTrustEvaluate|SecTrustEvaluateWithError" "im"
REPORT "iOS URLSession Trust Bypass Pattern"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
