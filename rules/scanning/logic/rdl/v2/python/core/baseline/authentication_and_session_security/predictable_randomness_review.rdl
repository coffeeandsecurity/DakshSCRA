VERSION 2
RULE baseline.python.core.predictable_randomness_review VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\bimport\\s+[^;\\n]{0,200}\\brandom\\b|\\bfrom\\s+random\\s+import\\b|\\brandom\\.(?:random|choice|choices|randint|randrange|getrandbits|uniform|Random)\\b" "im"
REPORT "Random Number Generation Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
