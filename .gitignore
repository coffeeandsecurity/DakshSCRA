# -----------------------------
# Python bytecode and caches
# -----------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# -----------------------------
# Virtual environments
# -----------------------------
venv/
.venv/
env/

# -----------------------------
# Runtime and generated outputs
# -----------------------------
runtime/*
/reports/*

# -----------------------------
# Node / frontend build output
# -----------------------------
node_modules/
webui/frontend/dist/

# -----------------------------
# Local environment/secrets
# -----------------------------
.env
.env.*
!.env.example

# -----------------------------
# Editor/OS artifacts
# -----------------------------
Thumbs.db
.*


# -----------------------------
# Local-only paths
# -----------------------------
/exclude/

# Public documentation allowlist; retain all other docs locally.
/docs/*
!/docs/usage-guide.html
!/docs/usage-guide.md

# Local validation files.
/tests/
/examples/

# Public utilities; other tools remain local.
/tools/*
!/tools/start_webui.py
!/tools/rdl_lint.py
!/tools/rdl_migrate.py
!/tools/supported_platforms.py
!/tools/rdl_shadow_report.py
!/tools/prune_rdl_comparisons.py
