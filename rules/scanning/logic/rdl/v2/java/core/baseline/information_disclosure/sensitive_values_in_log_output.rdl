VERSION 2
RULE baseline.java.core.sensitive_values_in_log_output VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\b(?:System\\s*\\.\\s*(?:out|err)\\s*\\.\\s*(?:print|println|printf)|(?:log|logger)\\s*\\.\\s*(?:trace|debug|info|warn|error|fatal))\\s*\\(" "im"
REPORT "Sensitive Data Logging Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
