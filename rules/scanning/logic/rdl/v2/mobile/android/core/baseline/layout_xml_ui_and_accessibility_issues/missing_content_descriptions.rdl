VERSION 2
RULE baseline.mobile.android.core.missing_content_descriptions VERSION 1
IN FILE
WHEN TEXT_MATCHES "android:contentDescription\\s*=\\s*[\"'][\"']" "im"
WHEN (TEXT_MATCHES "android:contentDescription\\s*=\\s*\"\"|android:contentDescription\\s*=\\s*\"@null\"" "im" AND TEXT_MISSING "android:importantForAccessibility\\s*=\\s*\"no\"" "im")
REPORT "Missing Content Descriptions"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
