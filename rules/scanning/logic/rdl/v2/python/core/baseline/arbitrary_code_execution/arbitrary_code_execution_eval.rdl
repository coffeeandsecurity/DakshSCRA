VERSION 2
RULE baseline.python.core.arbitrary_code_execution_eval VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\beval\\(.+\\)" "im"
WHEN (TEXT_MATCHES "(input\\(|request|params|query|user_input|base64|pickle)" "im" AND TEXT_MISSING "(allowlist|whitelist)" "im")
REPORT "Dynamic Code Evaluation Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
