VERSION 2
RULE baseline.filepaths.core.file_upload VERSION 1
IN PATH
WHEN TEXT_MATCHES "(?i)Upload" "im"
WHEN (TEXT_MATCHES "(?i)(/|\\\\\\\\).*(upload|uploader|attachments?|files?)" "im" AND TEXT_MISSING "(?i)(/docs?/|/examples?/|/samples?/|/tests?/)" "im")
REPORT "File Upload Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
