VERSION 2
RULE baseline.common.core.sql_query_using_insert_update_delete_or_drop VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)\\b(?:INSERT(?:\\s+OR\\s+\\w+)?\\s+INTO|UPDATE\\s+[^\\s()]+\\s+SET|DELETE\\s+FROM|DROP\\s+(?:TABLE|DATABASE|VIEW|INDEX|SCHEMA))\\b[^\\n]*\\$\\{\\w+\\}" "im"
WHEN TEXT_MATCHES "(?i)\\b(query|execute|statement|sql)\\b" "im"
REPORT "Database Write Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
