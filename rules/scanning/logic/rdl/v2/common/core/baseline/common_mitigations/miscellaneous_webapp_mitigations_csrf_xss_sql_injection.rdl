VERSION 2
RULE baseline.common.core.miscellaneous_webapp_mitigations_csrf_xss_sql_injection VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)(CSRF|XSS|SQLi)" "im"
WHEN (TEXT_MATCHES "(?i)(ToLower|ToUpper)" "im" AND TEXT_MISSING "(?i)(sanitize|escape|encode|prepared|parameterized)" "im")
REPORT "Miscellaneous Webapp Mitigations: CSRF, XSS, SQL Injection"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
