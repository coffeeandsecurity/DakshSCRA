VERSION 2
RULE baseline.terraform.framework.aws.ec2_instance_with_public_ip VERSION 1
IN FILE
WHEN TEXT_MATCHES "associate_public_ip_address\\s*=\\s*true" "im"
WHEN (TEXT_MATCHES "associate_public_ip_address\\s*=\\s*true" "im" AND TEXT_MISSING "# intentional|# bastion|# jump|# nat" "im")
REPORT "EC2 Instance with Public IP"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
