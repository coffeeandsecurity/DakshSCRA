VERSION 2
RULE baseline.dockerfile.core.secret_passed_via_arg_instruction VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)^ARG\\s+(?:PASSWORD|SECRET|API_KEY|APIKEY|TOKEN|ACCESS_KEY|PRIVATE_KEY|AUTH_TOKEN)" "im"
WHEN (TEXT_MISSING "placeholder|example|test|dummy|TODO" "im" AND TEXT_MATCHES "ARG.*(KEY|SECRET|PASSWORD|TOKEN|PASS|CREDENTIAL)" "im")
REPORT "Secret Passed via ARG Instruction"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
