VERSION 2
RULE baseline.c.core.suppressing_compiler_warnings VERSION 1
IN FILE
WHEN TEXT_MATCHES "CFLAGS\\s*=.*\\b(-w)\\b" "im"
WHEN (TEXT_MATCHES "#pragma\\s+warning\\s*\\(\\s*disable|-Wno-error|-w\\b|/W0|__attribute__.*unused.*//.*suppress" "im" AND TEXT_MISSING "// intentional|// NOLINT" "im")
REPORT "Compiler Warning Configuration Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
