VERSION 2
RULE baseline.dotnet.core.sql_query_non_parameterized_insert_statements VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)\\bINSERT INTO\\s+[^\\s]+\\s+\\(.*=.*\\$.*" "im"
WHEN TEXT_MISSING "(SqlParameter|AddWithValue|Parameters\\.Add|Parameters\\.AddWithValue)" "im"
REPORT "SQL Query: Non-parameterized INSERT Statements"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
