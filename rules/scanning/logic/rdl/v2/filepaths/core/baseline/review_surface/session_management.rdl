VERSION 2
RULE baseline.filepaths.core.session_management VERSION 1
IN PATH
WHEN TEXT_MATCHES "(?i)(session|cookie|token)" "im"
WHEN (TEXT_MATCHES "(?i)(/|\\\\\\\\).*(session|cookie|token)" "im" AND TEXT_MISSING "(?i)(/docs?/|/examples?/|/samples?/|/tests?/|example|sample|dummy|test|placeholder)" "im")
REPORT "Session Management"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
