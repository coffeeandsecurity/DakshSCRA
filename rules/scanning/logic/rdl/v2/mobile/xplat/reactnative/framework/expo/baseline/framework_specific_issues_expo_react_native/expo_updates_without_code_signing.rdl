VERSION 2
RULE baseline.mobile.xplat.reactnative.framework.expo.expo_updates_without_code_signing VERSION 1
IN FILE
WHEN TEXT_MATCHES "\"expo-updates\"|expoConfig(?:[^\\n]*|[^;{}]*?)updates|updates\\.url|runtimeVersion" "im"
REPORT "Expo Update Signature Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
