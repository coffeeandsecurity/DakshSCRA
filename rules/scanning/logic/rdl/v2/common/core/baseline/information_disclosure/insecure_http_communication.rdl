VERSION 2
RULE baseline.common.core.insecure_http_communication VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)\\b(?:url|uri|endpoint|baseurl|server|host|href|src|fetch|axios|httpclient|xmlhttprequest|request|location|window\\.open|redirect)[^\\n]{0,220}http://" "im"
REPORT "Cleartext HTTP Communication Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
