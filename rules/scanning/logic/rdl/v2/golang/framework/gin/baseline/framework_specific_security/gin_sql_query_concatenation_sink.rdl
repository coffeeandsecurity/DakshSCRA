VERSION 2
RULE baseline.golang.framework.gin.gin_sql_query_concatenation_sink VERSION 1
IN FILE
WHEN TEXT_MATCHES "Query\\(\\s*fmt\\.Sprintf|Exec\\(\\s*fmt\\.Sprintf|Raw\\(\\s*fmt\\.Sprintf" "im"
WHEN TEXT_MISSING "Prepare\\s*\\(|QueryContext\\s*\\(.*\\?|db\\.Raw\\s*\\(.*\\?|squirrel|sqlx\\.NamedExec|bindParams" "im"
REPORT "Gin SQL Query Concatenation Sink"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
