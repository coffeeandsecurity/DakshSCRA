VERSION 2
RULE baseline.common.core.unvalidated_redirects_and_forwards VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)\\b(redirect|forward|sendRedirect|Response\\.Redirect|res\\.redirect|window\\.location|location\\.href)\\s*(\\(|=)" "im"
WHEN TEXT_MISSING "(?i)\\b(allowlist|whitelist|isLocalUrl|startsWith\\(\\s*['\\\"]/|same-origin)\\b" "im"
REPORT "Unvalidated Redirects and Forwards"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
