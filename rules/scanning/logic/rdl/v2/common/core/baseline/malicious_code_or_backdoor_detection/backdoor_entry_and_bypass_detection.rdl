VERSION 2
RULE baseline.common.core.backdoor_entry_and_bypass_detection VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)\\b(backdoor|bypass|sneaky|exploit|unauthorized_access|unauthorized_entry|hidden_entry|stealthy_entry|secret_entry)\\b" "im"
WHEN TEXT_MISSING "(?i)\\b(example|sample|dummy|test|placeholder|ctf|training)\\b" "im"
REPORT "Backdoor Entry and Bypass Detection"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
