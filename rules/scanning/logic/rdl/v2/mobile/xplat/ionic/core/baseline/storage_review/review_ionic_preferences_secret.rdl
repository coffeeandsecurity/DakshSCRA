VERSION 2
RULE baseline.mobile.xplat.ionic.core.review_ionic_preferences_secret VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)\\bPreferences\\.set\\s*\\(\\s*\\{[^}]{0,300}\\bkey\\s*:\\s*[\"\\x27](?:password|token|secret|credential)[\"\\x27]" "im"
REPORT "Preferences Data Storage Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
