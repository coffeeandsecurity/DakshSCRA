VERSION 2
RULE baseline.filepaths.core.user_section VERSION 1
IN PATH
WHEN TEXT_MATCHES "(?i)\\buser\\b" "im"
WHEN (TEXT_MATCHES "(?i)(/|\\\\\\\\).*(user|users|profile|account)" "im" AND TEXT_MISSING "(?i)(/docs?/|/examples?/|/samples?/|/tests?/)" "im")
REPORT "User Account Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
