VERSION 2
RULE baseline.mobile.android.framework.jetpack.android_webview_javascript_enabled VERSION 1
IN FILE
WHEN TEXT_MATCHES "setJavaScriptEnabled\\(\\s*true\\s*\\)" "im"
WHEN (TEXT_MISSING "setSafeBrowsingEnabled\\(\\s*true\\s*\\)" "im" AND TEXT_MISSING "setAllowFileAccess\\(\\s*false\\s*\\)" "im")
REPORT "Android WebView JavaScript Enabled"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
