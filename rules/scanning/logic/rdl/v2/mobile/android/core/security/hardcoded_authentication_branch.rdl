VERSION 2
RULE android.hardcoded-authentication-branch VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\b(?:password|passwd|pin|authToken)\\s*(?:==\\s*[\"\\x27][^\"\\x27\\r\\n]{1,100}[\"\\x27]|\\.\\s*equals\\s*\\(\\s*[\"\\x27][^\"\\x27\\r\\n]{1,100}[\"\\x27]\\s*\\))" ""
REPORT "Hardcoded Authentication Review"
SEVERITY MEDIUM
CONFIDENCE LOW
WITH TRACE
