VERSION 2
RULE baseline.mobile.android.framework.jetpack.android_cleartext_traffic_enabled VERSION 1
IN FILE
WHEN TEXT_MATCHES "[A-Za-z_][\\w.-]*:usesCleartextTraffic\\s*=\\s*\"true\"|cleartextTrafficPermitted\\s*=\\s*true" "im"
REPORT "Cleartext Network Policy Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
