VERSION 2
RULE baseline.common.core.ipv4_ipv6_address VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?<![A-Za-z0-9_:.%])(?:[A-Fa-f0-9]{0,4}:){2,8}[A-Fa-f0-9.]{0,45}(?:%[A-Za-z0-9_.~-]{1,64})?(?![A-Za-z0-9_:.%])|(?<![A-Za-z0-9_:.])(?:[0-9]{1,3}\\.){3}[0-9]{1,3}(?![A-Za-z0-9_.%])" "im"
REPORT "IP Address Usage Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
