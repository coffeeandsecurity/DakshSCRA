VERSION 2
RULE baseline.common.core.sql_query_using_insert_update_delete_or_drop VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)(INSERT|UPDATE|DELETE|DROP).*\\$\\{\\w+\\}.*" "im"
WHEN TEXT_MATCHES "(?i)\\b(query|execute|statement|sql)\\b" "im"
REPORT "SQL Query: Using INSERT, UPDATE, DELETE, or DROP"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
