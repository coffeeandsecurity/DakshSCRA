VERSION 2
RULE baseline.mobile.android.core.webview_universal_file_access_enabled VERSION 1
IN FILE
WHEN TEXT_MATCHES "setAllowUniversalAccessFromFileURLs\\s*\\(\\s*true\\s*\\)|setAllowFileAccessFromFileURLs\\s*\\(\\s*true\\s*\\)" "im"
WHEN (TEXT_MATCHES "setAllowUniversalAccessFromFileURLs\\s*\\(\\s*true|setAllowFileAccessFromFileURLs\\s*\\(\\s*true" "im" AND TEXT_MISSING "test|example" "im")
REPORT "WebView Universal File Access Enabled"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
