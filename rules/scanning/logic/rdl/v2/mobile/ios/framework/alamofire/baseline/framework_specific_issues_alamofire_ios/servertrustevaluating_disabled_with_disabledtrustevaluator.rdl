VERSION 2
RULE baseline.mobile.ios.framework.alamofire.servertrustevaluating_disabled_with_disabledtrustevaluator VERSION 1
IN FILE
WHEN TEXT_MATCHES "DisabledTrustEvaluator\\s*\\(\\s*\\)|trustAllCertificates|serverTrustManager\\s*=\\s*nil" "im"
WHEN TEXT_MISSING "test|development|localhost|staging|PinnedCertificatesTrustEvaluator|RevocationTrustEvaluator" "im"
REPORT "ServerTrustEvaluating Disabled with DisabledTrustEvaluator"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
