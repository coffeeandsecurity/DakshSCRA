VERSION 2
RULE baseline.mobile.android.core.webview_universal_file_access_enabled VERSION 1
IN FILE
WHEN TEXT_MATCHES "setAllowUniversalAccessFromFileURLs\\s*\\(\\s*true\\s*\\)|setAllowFileAccessFromFileURLs\\s*\\(\\s*true\\s*\\)" "im"
REPORT "WebView File Access Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
