VERSION 2
RULE android.biometric-enrollment-invalidation-disabled VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\b(?:setInvalidatedByBiometricEnrollment\\s*\\(\\s*false\\s*\\)|invalidatedByBiometricEnrollment\\s*=\\s*false\\b)" ""
REPORT "Biometric Key Invalidation Review"
SEVERITY MEDIUM
CONFIDENCE LOW
WITH TRACE
