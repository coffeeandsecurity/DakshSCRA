VERSION 2
RULE baseline.common.core.trusted_or_untrusted_urls VERSION 1
IN FILE
WHEN TEXT_MATCHES "(?i)(?:\\b(?:redirect|forward|sendRedirect|Response\\.Redirect|res\\.redirect|window\\.location|location\\.href|location\\.replace|window\\.open)\\b[^\\n]{0,220}https?://|\\b(?:fetch|axios|httpclient|xmlhttprequest|request)\\b[^\\n]{0,220}(https?://|\\+|\\$\\{)|\\b(?:url|uri|endpoint|baseurl|api[_-]?url|callback[_-]?url|redirect[_-]?url|host|server)\\b\\s*[:=]\\s*[\"']?\\s*https?://)" "im"
REPORT "URL Usage Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
