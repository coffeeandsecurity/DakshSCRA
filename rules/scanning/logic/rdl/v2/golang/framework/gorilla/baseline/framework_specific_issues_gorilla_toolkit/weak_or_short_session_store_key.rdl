VERSION 2
RULE baseline.golang.framework.gorilla.weak_or_short_session_store_key VERSION 1
IN FILE
WHEN TEXT_MATCHES "sessions\\.NewCookieStore\\s*\\(\\s*\\[\\]byte\\s*\\(\\s*[\"'][^\"']{1,15}[\"']\\s*\\)" "im"
WHEN (TEXT_MISSING "rand\\.Read|crypto/rand|os\\.Getenv|SecretKeyBase|config\\." "im" AND TEXT_MISSING "test|example|placeholder" "im")
REPORT "Weak or Short Session Store Key"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
