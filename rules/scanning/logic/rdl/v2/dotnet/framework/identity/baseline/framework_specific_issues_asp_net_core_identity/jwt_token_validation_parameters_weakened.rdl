VERSION 2
RULE baseline.dotnet.framework.identity.jwt_token_validation_parameters_weakened VERSION 1
IN FILE
WHEN TEXT_MATCHES "ValidateIssuer\\s*=\\s*false|ValidateAudience\\s*=\\s*false|ValidateLifetime\\s*=\\s*false|ValidateIssuerSigningKey\\s*=\\s*false" "im"
WHEN (TEXT_MATCHES "ValidateIssuer\\s*=\\s*false|ValidateAudience\\s*=\\s*false|ValidateLifetime\\s*=\\s*false|ValidateIssuerSigningKey\\s*=\\s*false" "im" AND TEXT_MISSING "test|example|development" "im")
REPORT "JWT Token Validation Parameters Weakened"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
