VERSION 2
RULE baseline.mobile.android.core.deep_link_without_app_link_verification VERSION 1
IN FILE
WHEN TEXT_MATCHES "[A-Za-z_][\\w.-]*:scheme\\s*=\\s*\"(?!https?)[^\"]+\"|<data\\s[^>]*[A-Za-z_][\\w.-]*:host\\s*=" "im"
REPORT "Deep Link without App Link Verification"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
