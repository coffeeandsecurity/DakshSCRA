VERSION 2
RULE baseline.mobile.xplat.flutter.core.sharedpreferences_sensitive_data VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\bSharedPreferences\\.getInstance\\s*\\(" "i"
WHEN TEXT_MATCHES "SharedPreferences.*(?:password|token|secret|key|credential|auth)|prefs\\.setString.*(?:password|token|secret|key|auth)" "im"
WHEN PROJECT_OBSERVATION "**/pubspec.yaml"
REPORT "Insecure SharedPreferences for Sensitive Data"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
