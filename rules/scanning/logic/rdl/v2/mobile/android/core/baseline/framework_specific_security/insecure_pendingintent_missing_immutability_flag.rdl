VERSION 2
RULE baseline.mobile.android.core.insecure_pendingintent_missing_immutability_flag VERSION 1
IN FILE
WHEN TEXT_MATCHES "PendingIntent\\.(getBroadcast|getActivity|getService|getForegroundService)\\s*\\(" "im"
WHEN TEXT_MISSING "FLAG_IMMUTABLE|FLAG_UPDATE_CURRENT\\s*\\|\\s*FLAG_IMMUTABLE|PendingIntentCompat" "im"
REPORT "Insecure PendingIntent: Missing Immutability Flag"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
