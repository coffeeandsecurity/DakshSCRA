VERSION 2
RULE baseline.javascript.core.node_inspector_exposed_via_inspect VERSION 1
IN FILE
WHEN TEXT_MATCHES "\\B--inspect(?:-brk)?(?:=\\S+)?\\b" "im"
WHEN (TEXT_MATCHES "--inspect|--inspect-brk" "im" AND TEXT_MISSING "development|localhost|127\\.0\\.0\\.1|test" "im")
REPORT "Node Inspector Exposure Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
