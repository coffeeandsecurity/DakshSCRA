IN FILE
WHEN TEXT_MATCHES "\\.Exec\\s*\\(\\s*[\"'][^\"']*[\"']\\s*\\+|\\.Exec\\s*\\(\\s*fmt\\.Sprintf\\s*\\([\"'][^\"']*%[sv]" "im"
WHEN TEXT_MISSING "\\.Exec\\s*\\(\\s*\"[^\"]*\\?|\\.Exec\\s*\\(\\s*\"[^\"]*@|PreparedStatement|parameterized" "im"
