VERSION 2
RULE baseline.rust.framework.axum.axum_sql_injection_sink VERSION 1
IN FILE
WHEN TEXT_MATCHES "format!\\(\\s*\"\\s*SELECT|format!\\(\\s*\"\\s*INSERT|sql_query\\(\\s*format!" "im"
WHEN (TEXT_MISSING "query!\\s*\\(|sqlx::query!|prepare\\s*\\(|bind\\s*\\(|QueryBuilder|params" "im" AND TEXT_MISSING "test|example" "im")
REPORT "SQL Injection Review"
SEVERITY INFO
CONFIDENCE LOW
WITH TRACE
