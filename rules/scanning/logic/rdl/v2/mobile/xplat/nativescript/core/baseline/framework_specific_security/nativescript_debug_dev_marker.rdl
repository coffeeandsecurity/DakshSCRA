VERSION 2
RULE baseline.mobile.xplat.nativescript.core.nativescript_debug_dev_marker VERSION 1
IN FILE
WHEN TEXT_MATCHES "NODE_ENV\\s*=\\s*[\\'\\\"]development[\\'\\\"]|debug\\s*[:=]\\s*true" "im"
